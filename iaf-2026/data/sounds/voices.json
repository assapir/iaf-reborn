      {
        "file": "he/twr_takeoff_ramon.wav",
        "text": "סופה אחת, מגדל רמון, מסלול שתיים חמש ימני, רוח שקטה, מאושר להמראה.",
        "ipa": "sufˈa aχˈat, migdˈal ʁamˈon, maslˈul ʃtˈajim χˈameʃ jemanˈi, ʁˈuaχ ʃketˈa, meuʃˈaʁ lehamʁaˈa."
      },
      {
        "file": "he/twr_start.wav",
        "text": "מאושר להתניע.",
        "ipa": "meuʃˈaʁ lehatnˈia."
      },
      {
        "file": "he/twr_taxi_rwy.wav",
        "text": "הסע למסלול",
        "ipa": "hasˈa lamaslˈul"
      },
      {
        "file": "he/twr_lineup_rwy.wav",
        "text": "היכנס למסלול",
        "ipa": "hikanˈes lamaslˈul"
      },
      {
        "file": "he/twr_hold_pos.wav",
        "text": "המתן במקום",
        "ipa": "hamtˈen bamakˈom"
      },
      {
        "file": "he/twr_takeoff.wav",
        "text": "מאושר להמראה",
        "ipa": "meuʃˈaʁ lehamʁaˈa"
      },
      {
        "file": "he/twr_wind_calm.wav",
        "text": "רוח שקטה",
        "ipa": "ʁˈuaχ ʃketˈa"
