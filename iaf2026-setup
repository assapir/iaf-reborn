#!/usr/bin/env bash
# IAF 2026's setup: builds the sim's data into assets/ (iaf-sim, iaf-2026/docs/data-formats.md) and the extension.
# Its wizard comes with item A3; until then this runs the compilers from the command line.
set -euo pipefail
cd "$(dirname "$0")"
command -v cargo >/dev/null || { echo "IAF 2026 needs Rust (cargo): rustup.rs" >&2; exit 1; }
echo "IAF 2026's setup wizard comes with item A3; building the sim's data from the command line (iaf-sim all)…"
cargo build --release -p iaf-godot
cargo build --release -p iaf-tools --bin iaf-sim
target/release/iaf-sim all iaf-2026/data assets
