#!/usr/bin/env bash
# Builds what changed (the Rust extension the game loads) and starts the game — named after the original
# iafjets.exe. Without game data it starts the setup wizard (./setup). Extra arguments go to the game (after --), e.g. ./iafjets --mission 311.
# IAF_SCENE=res://… starts that scene instead of the main menu (./mission-editor).
set -euo pipefail
cd "$(dirname "$0")"
[[ -d assets/converted ]] || { echo "No game data yet: starting the setup wizard (./setup)." >&2; exec ./setup; }
cargo build --release -p iaf-godot
godot=${GODOT:-godot}
if ! command -v "$godot" >/dev/null && [[ -x /Applications/Godot.app/Contents/MacOS/Godot ]]; then
	godot=/Applications/Godot.app/Contents/MacOS/Godot
fi
# Godot's import on a fresh clone (it loads iaf.gdextension only once an import has listed it) and after a pull that
# brought new or changed shaders or textures (tools/godot_import.sh).
tools/godot_import.sh "$godot"
# macOS: SDL's GameController (MFi) backend hides sticks like the T.Flight Hotas X from Godot; plain IOKit HID sees them.
[[ $(uname) == Darwin ]] && export SDL_JOYSTICK_MFI=${SDL_JOYSTICK_MFI:-0}
exec "$godot" --path game ${IAF_SCENE:+"$IAF_SCENE"} -- "$@"
