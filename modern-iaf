#!/usr/bin/env bash
# Builds what changed (the Rust extension, the same one ./iafjets loads) and starts Modern IAF (iaf-2026/README.md).
# Without the sim's data (its missions are the last step) it starts its setup wizard (./modern-iaf-setup). Extra arguments go to the sim (after --).
# It opens the front end (iaf-2026/main.tscn); `-- --mission <id>` flies that mission at once, then shows its debrief.
set -euo pipefail
cd "$(dirname "$0")"
[[ -d ${IAF_ASSETS_DIR:-assets}/converted/iaf-2026/missions ]] || { echo "No Modern IAF data yet: starting its setup (./modern-iaf-setup)." >&2; exec ./modern-iaf-setup; }
title="Modern IAF"
who="Modern IAF"
# shellcheck source=tools/launch-checks.sh
source tools/launch-checks.sh
cargo build --release -p iaf-godot
tools/godot_import.sh "$godot" iaf-2026
[[ $(uname) == Darwin ]] && export SDL_JOYSTICK_MFI=${SDL_JOYSTICK_MFI:-0}
exec "$godot" --path iaf-2026 res://main.tscn -- "$@"
