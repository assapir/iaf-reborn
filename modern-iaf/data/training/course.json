    "night_lighting": {"label": {"en": "Cockpit lighting set for the night", "he": "תאורת תא הטייס מכוונת ללילה"}, "standard": {"limit": "min", "bands": [1, 1, 1], "unit": ""}, "comments": {"above": {"en": "The cockpit set for the night.", "he": "תא הטייס מוכן ללילה."}, "below": {"en": "The night lighting not set.", "he": "תאורת הלילה לא כוונה."}}, "tip": {"en": "Set the night lighting from the card before the taxi (in the F-35I: the helmet's night mode).", "he": "יש לכוון את תאורת הלילה לפי הכרטיס לפני ההסעה (ב-F-35I: מצב לילה בקסדה)."}},
