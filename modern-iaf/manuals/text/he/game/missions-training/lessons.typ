#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("שיעורים")#idx("אימון")#term("שיעור") הוא משימה מהרשימה #scr("sec_training") שבמסך #scr("missions") (@mission-list). לכל אחד משלושת המטוסים שלושה שיעורים, שמוטסים מהבסיס שלו. יש לטוס בהם לפי הסדר: כל שיעור נשען על הקודם.

=== השיעורים של כל מטוס <lessons-list>

#grid-table(
  (auto, 1fr, 1fr, 1fr),
  ([שיעור], [F-16I סופה, ברמון], [F-16D ברק, ברמת דוד], [F-35I אדיר, בנבטים]),
  [1. #scr("kind_startup")], [משימה 2011], [משימה 2021], [משימה 2031],
  [2. #scr("kind_takeoff")], [משימה 2012, מסלול 25R], [משימה 2022, מסלול 27], [משימה 2032, מסלול 26L],
  [3. מטווח חימוש], [משימה 2013, מסלול 25R], [משימה 2023, מסלול 27], [משימה 2033, מסלול 26L],
)

מספר המשימה מפעיל שיעור ישירות משורת הפקודה (@start-game). הבסיסים מתוארים ב@airbases.

=== מה כל שיעור מלמד <lessons-teach>

#grid-table(
  (auto, 1fr, auto, auto),
  ([שיעור], [מה עושים], [#term("זמן מוקצב")], [הסבר]),
  [#scr("kind_startup")], [#scr-text("desc_startup") מטוס קר מופעל לפי הבד״ח שלו, אחרי שה#term("מגדל") מאשר את ההתנעה.], [10 דקות], [@lesson-startup],
  [#scr("kind_takeoff")], [#scr-text("desc_takeoff") מתניעים את המטוס, משמיעים את ארבע הקריאות, מסיעים למסלול, ממריאים ומטפסים.], [15 דקות], [@lesson-takeoff],
  [מטווח חימוש], [#scr-text("desc_range") מתניעים וממריאים כמו קודם, ואז טסים למטווח.], [45 דקות], [@lesson-range],
)

כל שלושת השיעורים של מטוס מתחילים ב-08:00 או ב-09:00 בבוקר, באור יום, בלי רוח.

=== איך שיעור מתחיל <lessons-start>

#idx("התנעה ממצב קר, בשיעור")כל שיעור מתחיל באותו אופן: המטוס עומד בעמדת החניה שלו, קר. המנוע כבוי, אין מתח חשמלי, כל התצוגות חשוכות והחופה פתוחה. הזזת המצערת אינה מתניעה דבר. בכל שיעור מתניעים את המטוס שלב אחר שלב, לפי הבד״ח שלו.

- בשיעור ההתנעה ה#term("פנקס") מורם בלשונית הבד״ח כשהטיסה מתחילה (@notebook-open). בשני האחרים הוא מונח על הירך.
- בכל שיעור טבעת בתא הטייס מסמנת את הפקד של פריט הבד״ח שיש לבצע עכשיו (@notebook-ring).
- שעון הזמן המוקצב רץ מהרגע הראשון של הטיסה.

התדריך מתאר את מהלך השיעור לפי הסדר (@briefing-text). יש לקרוא אותו לפני הטיסה: בזמן הטיסה דבר אינו חוזר עליו, מלבד דפי הפנקס.

=== אחרי השיעורים <lessons-after>

#idx("מערכה")#idx("משימות בודדות")במסך #scr("missions") מופיעים גם #scr("sec_campaign"), #scr("sec_single") וכן #scr("sec_fly_now"). בשלושתם כתוב #scr("coming_later"): הם עדיין אינם בסימולטור.

שיעור שעבר נשאר פתוח. אפשר לטוס בו שוב בכל עת; #term("יומן טיסות", shown: "יומן הטיסות") שומר כל טיסה (@pilots).
