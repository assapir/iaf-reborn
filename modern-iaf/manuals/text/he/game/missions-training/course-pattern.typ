#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("שלב 2")#idx("הקפה")שלב 2 בהסבה, "שליטה בסיסית, המראה ונחיתה": מההמראה הראשונה ועד הקפה עם שבירה, הליכה סביב וחירום בהמראה ובטיסה. בשלב שמונה #term("תרגול")ים: שישה ביום, אחד בלילה, וטיסת מבחן 2. כל תרגול יוצא ממטוס קר בעמדת החניה ונגמר במנוע כבוי באותה עמדה. את שלבי התרגול ואת המספרים שיש להחזיק נותנים התדריך ולשונית התרגול ב#term("פנקס"). ההקפה עצמה מתוארת במדריך הטיסה של כל מטוס: #other("f16i", "landing"), #other("f16d", "landing") ו-#other("f35i", "landing").

=== התרגולים <pattern-lessons>

#idx("שלב 2, תרגולים")
#grid-table(
  (auto, 2fr, 1fr),
  ([תרגול], [מה לומדים], [מה נמדד]),
  [2.1 המראה וטיסה ראשונה], [המראה, טיפוס, פניות אופקיות, וגישה ישירה לנחיתה.], [קו המרכז בריצת ההמראה, מהירות הניתוק, איסוף הכן אחרי הניתוק, מקום הנגיעה, מהירות השקיעה],
  [2.2 הקפה עם שבירה ונחיתה], [הקפה עם שבירה. ב-F-16 המדריך מטיס את הראשונה ("השליטה אצלי") ומחזיר את המטוס על המסלול. ב-F-35I המדריך מוביל אותה ממטוס שני ("לעקוב אחריי").], [גובה ההקפה, זווית ההתקפה בסופית, מקום הנגיעה, קו המרכז בנגיעה],
  [2.3 נגיעה והמראה, והליכה סביב], [נגיעה והמראה, הקפות סגורות, והליכה סביב מסופית קצרה.], [גובה ההקפה, זווית ההתקפה בסופית, הגובה הנמוך בהליכה סביב],
  [2.4 זווית התקפה גבוהה ועומסים], [טיסה איטית, מגבלי זווית ההתקפה והעומס, ופנייה במהירות הפנייה המיטבית.], [מהירות הטיסה האיטית, העומס המרבי, המהירות בפנייה],
  [2.5 ביטול המראה ואש במנוע], [אש במנוע בריצת ההמראה וביטול המראה; אחרי התנעה מחדש והמראה נוספת, אש במנוע בטיסה.], [עצירה על המסלול, הורדת מצערת אחרי נורית האש, צעדי החירום שבוצעו],
  [2.6 המנוע כבה באוויר והתנעה באוויר], [המנוע כבה באוויר, התנעה באוויר, והקפת מנוע כבוי עד נחיתה.], [התנעת המנוע מחדש, נחיתה על המסלול, צעדי החירום שבוצעו],
  [2.7 בלילה], [הקפה ונחיתה בלילה, עם אמר"ל או עם מצלמת הלילה בקסדה.], [גובה ההקפה, זווית ההתקפה בסופית, מקום הנגיעה],
  [2.8 טיסת מבחן 2], [כל שלבים 1 ו-2, בלי הנחיות בטיסה.], [הסעיפים של שלבים 1 ו-2],
)

כל סעיף נמדד מול התקן שלו, לפי המספרים של המטוס עצמו. צעדי החירום בלשונית החירום בפנקס.

=== טיסת מבחן 2 <pattern-check>

#idx("טיסת מבחן")המדריך נותן תדריך ו#term("תחקיר") בלבד: בטיסה אין הנחיות ואין הדגשת מתגים; הפנקס זמין. חירום אחד שכבר נלמד (אש במנוע בריצה או בטיסה, או מנוע שכבה באוויר) עלול להגיע בזמן אקראי, בלי הודעה מראש. הציון על הסעיפים של שלבים 1 ו-2, חוץ מסעיפי תרגול הלילה (הטיסה ביום), וסעיפי חירום רק אם החירום הגיע.
