#idx("מסלול האימון, שלב 7")#idx("קרב אוויר ויירוט")שלב 7, קרב אוויר ויירוט, הוא השלב השביעי במסלול האימון של כל מטוס: חמישה #term("תרגול")ים ביום, תרגול לילה וטיסת מבחן 7. כל אחד הוא גיחה מלאה מבסיס האם אל אזור אימונים וחזרה. הקרבות הם קרב האימון מול אדום 1 (@training-fight). התדריך במשחק נותן את שלבי התרגול, ומדריך הטיסה של המטוס נותן את החימוש: #other("f16i", "aa-weapons"), #other("f16d", "aa-weapons") ו-#other("f35i", "aa-weapons").

#grid-table(
