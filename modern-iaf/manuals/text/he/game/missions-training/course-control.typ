#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("קורס האימון, שלב 6")שלב 6 של קורס האימון מלמד לעבוד עם ה-#term("AWACS") (@awacs-requests) ועם #term("מטוס תדלוק") (@tanker). השלבים של כל תרגול נמצאים בתדריך שלו ובלשונית התרגול בפנקס; נוהל התדלוק נמצא במדריך של כל מטוס: #other("f16i", "air-refuelling"), #other("f16d", "air-refuelling") וכן #other("f35i", "air-refuelling").

#grid-table(
  (auto, 1fr, 1fr),
  ([תרגול], [מה הוא מלמד], [איך נותנים ציון]),
  [6.1 הצטרפות ל-AWACS ותמונת מצב], [כניסה לרשת, תמונת מצב והמגע הקרוב.], [הכניסה לרשת היא הבקשה הראשונה שלכם מה-AWACS.],
  [6.2 כיוונים], [טיסה בכיוונים של ה-AWACS אל מגע, העברת היירוט (\u{2066}Judy\u{2069}), הכיוון לבסיס.], [הכניסה לרשת; הכיוון שלכם 30 עד 90 שניות אחרי כל כיוון, בממוצע בתוך 5°, 10° או 20° ממנו.],
  [6.3 תדלוק אווירי], [הכיוון למטוס התדלוק, ההצטרפות, מגע, דלק עד מלא, הניתוק.], [הזמן ממייל ימי אחד מאחורי מטוס התדלוק עד המגע (2, 4 או 6 דקות); הניתוקים הלא מתוכננים (אף אחד, אחד או שניים); הדלק שנלקח מתוך המקום במכלים (כולו, 90% או 75%).],
  [6.4 בלילה], [תדלוק אווירי בלילה, לפי האורות של מטוס התדלוק.], [כמו 6.3.],
  [6.5 טיסת מבחן 6], [כל שלבים 1 עד 6 מלבד שלב המבנים.], [כל הפריטים של התרגולים בשלבים האלה.],
)

שלושת הגבולות של כל תקן הם של מעל לממוצע, ממוצע ומתחת לממוצע; מעבר לאחרון הפריט לא מספק. טיסת מבחן 6 נטסת ביום, בלי הנחיות המדריך בטיסה; הפנקס זמין, וחירום אחד שכבר נלמד עלול להגיע בזמן אקראי, בלי הודעה.
