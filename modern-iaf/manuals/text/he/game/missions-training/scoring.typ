#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("הצלחה וכישלון")#idx("בחינת המשימה")המשחק מסמן כל #term("שיעור") כ-#scr("pass") או כ-#scr("fail"). הסעיף הזה מפרט את הכללים שחלים בכולם. היעדים של כל שיעור נמצאים ב@lesson-startup, ב@lesson-takeoff וב@lesson-range.

מדריכי המטוסים מתארים מה נוהל עושה למטוס. הסעיף הזה מתאר מה המשחק עושה בעקבותיו.

=== איך משימה מסומנת <scoring-how>

- *הצלחה* דורשת שכל יעדי השיעור יושגו, בתוך ה#term("זמן מוקצב", shown: "זמן המוקצב"), בלי שיקרה בדרך דבר מ@scoring-at-once.
- *כישלון* בא מיד מכל אחד מהדברים שב@scoring-at-once, או בסוף הטיסה מיעד שלא הושג.

בכישלון מיידי מופיעה הודעה עם #scr("fail") והסיבה. חמש שניות אחר כך הטיסה מסתיימת וה#term("תחקיר") נפתח, כשהסיבה הזו ראשונה.

=== מה מכשיל כל משימה מיד <scoring-at-once>

#idx("כישלון מיידי")#grid-table(
  (1fr, 1.3fr, 1.2fr),
  ([מה נעשה], [מה המשחק עושה], [איך להימנע]),
  [#idx("התרסקות")המטוס התרסק.], [כישלון: "המטוס התרסק."], [לטוס בתוך מגבלות המטוס. על הקרקע, להסיע לאט.],
  [#idx("נזק")המטוס ספג נזק כלשהו.], [כישלון: "המטוס נפגע."], [להתרחק ממה שיורים בו ומהקרקע.],
  [#idx("ירידה מהמשטח הסלול")על הקרקע, מרכז המטוס ירד מהמשטח הסלול: המסלולים, מסלולי ההסעה, הרחבות ומשטחי הדת״קים. המשחק מתיר שוליים של 5 מ׳ מעבר לכל קצה.], [כישלון: "המטוס ירד מהמשטח הסלול."], [לשמור את גלגל האף על קו ההסעה הצהוב ולהאט לפני כל פנייה.],
  [בוצעה נטישה.], [כישלון: "בוצעה נטישה מהמטוס." (@time-pause-eject)], [לא לגעת במקש הנטישה.],
  [שלב על הקרקע בוצע לפני שה#term("מגדל") אישר אותו.], [המגדל אומר זאת. כישלון, והשלב הוא הסיבה (@scoring-clearances).], [לקרוא, להמתין לתשובה, ואז לפעול (@tower-ground).],
  [#idx("מסלול שגוי")המטוס רץ מעל 30 קשר לאורך מסלול שאינו המסלול של המשימה.], [כישלון: "ההמראה לא הייתה מהמסלול שהוקצה."], [להתיישר על המסלול שהמגדל ציין. המספר שלו מופיע בתדריך ובלשונית #scr("nb_taxi") של ה#term("פנקס").],
  [שלב בהתנעת המנוע בוצע שלא לפי הסדר, או שהמנוע כובה.], [המטוס מסרב לשלב או כבה. כישלון, והתקלה היא הסיבה (@scoring-order).], [לפעול לפי סדר הבד״ח (@notebook-checklist).],
)

=== איך האישורים נבדקים <scoring-clearances>

#idx("אישור")#term("אישור") הוא תשובת המגדל לקריאה. המשחק עוקב אחרי ארבעה רגעים על הקרקע. בכל אחד מהם הוא מחפש את האישור שאמור להיות בידי הטייס עד אז.

#grid-table(
  (auto, 1.2fr, 1fr, 1fr),
  ([שלב], [המשחק מזהה אותו כאשר], [התשובה שמאשרת אותו], [סיבת הכישלון]),
  [התנעת המנוע], [המנוע מסתובב: 5% #term("RPM") או יותר.], [\u{2066}"cleared to start"\u{2069}], ["התנעה ללא אישור התנעה מהמגדל."],
  [הסעה], [המטוס על הקרקע, יותר מ-10 מ׳ מהמקום שבו עמד בהתחלה.], [\u{2066}"taxi to runway ..."\u{2069}], ["הסעה ללא אישור הסעה מהמגדל."],
  [כניסה למסלול], [המטוס על המסלול של המשימה, מיושר לאורכו.], [\u{2066}"line up runway ..."\u{2069} או \u{2066}"cleared for take-off"\u{2069}], ["כניסה למסלול ללא אישור מהמגדל."],
  [ריצת ההמראה], [המטוס על המסלול הזה ומהיר מ-30 קשר.], [\u{2066}"cleared for take-off"\u{2069}], ["ריצת המראה ללא אישור המראה מהמגדל."],
)

- \u{2066}"hold position"\u{2069} אינו מאשר דבר. יש לקרוא שוב.
- אישור שניתן נשמר עד סוף הטיסה.
- התשובה של המגדל היא האישור: פועלים לפיה.
- רק פעולה בלי האישור שלה מכשילה את המשימה. קריאה שלא לפי הסדר, או קריאה כפולה, אינה עולה דבר.

שיעורי ההתנעה בודקים את שני השלבים הראשונים. שיעורי ההמראה ומטווח החימוש בודקים את כל הארבעה.

*המסלול השגוי.* בהתיישרות בתוך \u{2066}30°\u{2069} מקצה מסלול שאינו של המשימה, המגדל אומר פעם אחת על איזה מסלול המטוס עומד ואיזה מסלול הוקצה, ושורה בפינה העליונה של המסך אומרת את אותו דבר כל עוד עומדים שם. התיישרות שם רק מזהירה. ריצה שם מכשילה את המשימה.

=== סדר התנעת המנוע <scoring-order>

#idx("Hot start, בשיעור")המטוס עצמו מסרב לשלב התנעה שבא שלא לפי הסדר, ומה שהמטוס עושה בעקבותיו מתואר במדריך שלו: #other("f16i", "cold-start"), #other("f16d", "cold-start") וכן #other("f35i", "cold-start"). בשיעור כל אחת מהתקלות האלה גם מכשילה את המשימה מיד.

#grid-table(
  (1.1fr, 1.4fr, auto),
  ([מה נעשה], [הסיבה בתחקיר], [מטוס]),
  [המתנע הופעל כשהמתח הראשי כבוי.], ["למתנע לא היה מתח: המתח הראשי היה כבוי."], [כולם],
  [המצערת הועברה לסרק מתחת ל-20% RPM: #term("Hot start").], ["המצערת הועברה לסרק מתחת ל־20% סל״ד (Hot start); המנוע כובה."], [סופה, ברק],
  [המצערת הועברה לסרק כשהמנוע אינו מסתובב.], ["אין הצתה: המצערת הועברה לסרק כשהמנוע לא הסתובב."], [סופה, ברק],
  [האוויוניקה הופעלה לפני שהמנוע פעל.], ["מתח אוויוניקה הופעל לפני הגנרטורים: לא היה להם מתח."], [סופה, ברק],
  [בורר ה-#term("INS") סובב כשהמתח הראשי כבוי.], ["יישור הניווט האינרציאלי ללא מתח ראשי."], [סופה, ברק],
