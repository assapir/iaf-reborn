#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("שיעור ההתנעה")ה#term("שיעור") הראשון של כל מטוס: משימות 2011 (סופה, רמון), 2021 (ברק, רמת דוד) ו-2031 (אדיר, נבטים).

=== המטרה <lesson-startup-purpose>

לומדים להפעיל מטוס קר בסדר האמיתי, לפי כרטיס הבד"ח של המטוס, ולבקש רשות מה#term("מגדל") לפני ההתנעה. השיעור מסתיים בעמדת החניה: אין הסעה.

הנוהל עצמו, מתג אחר מתג, נמצא במדריך של כל מטוס: #other("f16i", "cold-start"), #other("f16d", "cold-start") וכן #other("f35i", "cold-start"). הסעיף הזה מתאר מה המשחק בודק.

=== מה המשחק בודק <lesson-startup-objectives>

התדריך מפרט שלושה יעדים:

- #scr("obj_idle")
- #scr("obj_avionics")
- #scr("obj_safe")

כולם בתוך 10 דקות מההתחלה.

השיעור עובר כשכל אלה מתקיימים:

#grid-table(
  (auto, 1fr),
  ([בדיקה], [בדיוק]),
  [המגדל אישר את ההתנעה], [התנעה התבקשה, ו-\u{2066}"cleared to start"\u{2069} נשמע לפני שהמנוע הסתובב (@tower-ground).],
  [הבד"ח בוצע], [כל פריט בכרטיס, מראשו ועד סוף החלק שלפני ההסעה, מסומן בבד"ח, מלבד הפריטים שרק קוראים ומאשרים (@notebook-checklist). בסופה ובברק יש 33 פריטים כאלה. באדיר 14.],
  [המנוע בסרק], [המנוע פועל ב-60% #term("RPM") או יותר.],
  [האוויוניקה פועלת], [לתצוגות ולאוויוניקה יש מתח. באדיר האוויוניקה מדווחת שהיא מוכנה 90 שניות אחרי הפעלת המצבר.],
  [בזמן], [כל האמור בתוך 10 דקות מתחילת הטיסה.],
  [דבר לא נכשל], [לא קרה אף אחד מהדברים שמכשילים כל משימה מיד (@scoring-at-once).],
)

כשהבדיקה האחרונה מתקיימת, הלוח #scr("fl_complete") נפתח (@time-pause-done). ב#term("תחקיר") כתוב אז: #scr-text("done_startup")

בסופה ובברק הדבר האחרון שמתקיים הוא בדרך כלל ה-#term("INS"): היישור שלו נמשך 90 שניות מהרגע שהבורר שלו עובר ל-STOR HDG, והפריט שלו בוצע רק כשהבורר ממשיך אחר כך ל-NAV. כדאי להתחיל את היישור מיד כשיש מתח לאוויוניקה, ולבצע את שאר הפריטים בזמן שהוא רץ.

=== היעדים בתחקיר <lesson-startup-debrief>

#grid-table(
  (auto, 1fr),
  ([יעד], [הערך הנדרש]),
  [סרק ואוויוניקה פועלת תוך 10 דקות], [הזמן שנדרש בפועל, מול 10 דקות.],
  [שלבי הבד"ח שבוצעו], [הפריטים שבוצעו, מול הפריטים שהשיעור דורש.],
)

=== מה מכשיל אותו <lesson-startup-fails>

#grid-table(
  (1fr, 1.2fr, 1.2fr),
  ([מה נעשה], [מה המשחק עושה], [איך להימנע]),
  [המנוע סובב לפני שהמגדל אישר את ההתנעה.], [המגדל אומר \u{2066}"engine start without clearance"\u{2069}. המשימה נכשלת מיד.], [לבקש התנעה קודם ולהמתין ל-\u{2066}"cleared to start"\u{2069}.],
  [המטוס זז יותר מ-10 מ' מהעמדה שלו.], [המגדל אומר \u{2066}"taxi without clearance"\u{2069}. המשימה נכשלת מיד.], [לא לגעת בבלמים ולהשאיר את המצערת בסרק. בשיעור הזה אין הסעה.],
  [שלב התנעה בוצע שלא לפי הסדר.], [המטוס מסרב לשלב. הבד"ח מציג את התקלה באדום. המשימה נכשלת מיד, והתקלה היא הסיבה (@scoring-order).], [לעקוב אחרי הפס הצהוב מראש הכרטיס. לקרוא את שורת הרמז לפני כל לחיצה (@notebook-hints).],
  [המצערת הועברה ל-OFF כשהמנוע פועל.], [המנוע כבה. המשימה נכשלת מיד.], [אחרי שהמנוע פועל, לא לגעת במקש שמעביר את המצערת ל-OFF.],
  [עברו 10 דקות לפני שהבדיקות התקיימו.], [חמש שניות אחר כך המשימה מסתיימת בכישלון. הסיבה מציינת מה חסר: "המנוע לא הותנע.", "המנוע לא הגיע לסרק עם אוויוניקה פועלת.", או שלב ההתנעה הראשון שדולג.], [להתחיל את יישור ה-INS מוקדם. לעבור לפריט הבא מיד כשפריט בוצע.],
  [הטיסה הסתיימה כשפריטים נשארו פתוחים.], [המשימה נכשלת. הסיבה מציינת את שלב ההתנעה הראשון שדולג, או שפריט בבד"ח לא בוצע.], [להישאר עד שהלוח #scr("fl_complete") נפתח.],
)

התרסקות, נזק, נטישה או ירידה מהמשטח הסלול מכשילות את השיעור הזה כמו כל משימה (@scoring-at-once).

=== הסיבות הרגילות לכישלון <lesson-startup-usual>

- *ההתנעה קדמה לקריאה.* השורה הראשונה בדף הבד"ח היא הקריאה למגדל. יש להשמיע אותה ראשונה.
- *המצערת הוזזה מוקדם מדי.* בסופה ובברק יש להמתין עד שמד ה-RPM מראה 20% לפני שמזיזים את המצערת מ-OFF לסרק. הטבעת שסביב המד מציגה את הערך שיש לחכות לו.
- *המתח הראשי עומד ב-BATT.* למתג שלושה מצבים. לחיצה אחת מ-OFF נותנת BATT, והבאה נותנת MAIN PWR (@clicking-three).
- *האוויוניקה הופעלה מוקדם מדי.* יש להמתין למנוע בסרק. הגנרטורים מתחברים רגע לפני הסרק, והאוויוניקה מקבלת מהם את המתח.
- *נראה שהשיעור הסתיים ודבר אינו קורה.* פריט גבוה יותר בכרטיס עדיין פתוח. יש לדפדף ב#term("פנקס") אחורה אל הפס הצהוב.
