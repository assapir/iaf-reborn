#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("מסלול האימון, שלב 1")#idx("קרקע והתנעה")שלב 1, קרקע והתנעה, הוא השלב הראשון במסלול האימון של כל מטוס: חמישה #term("תרגול")ים על הקרקע בבסיס האם של המטוס (ברק ברמת דוד, סופה ברמון, אדיר בנבטים). כל תרגול מתחיל במטוס קר וכבוי בעמדת החניה. התדריך במשחק נותן את שלבי התרגול, ומדריך הטיסה של המטוס נותן את הנוהל: #other("f16i", "cold-start"), #other("f16d", "cold-start") ו-#other("f35i", "cold-start").

#grid-table(
  (auto, 1fr, 1fr),
  ([תרגול], [מה הוא מלמד], [איך הוא נבחן]),
  [1.1 תא הטייס והזנת חשמל], [הכנת תא הטייס להתנעה, הזנת חשמל וכיבויו, נוריות האזהרה, בדיקת קשר. ללא מנוע.], [סעיפי הבד"ח שבוצעו; קריאות הקשר שבוצעו.],
  [1.2 התנעת המנוע ויישור #term("INS")], [התנעה מלאה לפי הבד"ח עם יישור ה-INS, ואחריה כיבוי.], [זמן ההתנעה עד סרק עם אוויוניקה פועלת; סעיפי הבד"ח שבוצעו; יישור INS לפני ההסעה.],
  [1.3 הסעה וקשר], [קריאות הקרקע, הסעה לנקודת ההמתנה של מסלול וחזרה, כיבוי.], [קריאות הקשר שבוצעו; מהירות ההסעה הגבוהה ביותר; סעיפי הבד"ח שבוצעו.],
  [1.4 בלילה], [התנעה עם תא טייס מכוון ללילה, הסעה בלילה.], [זמן ההתנעה; תאורת תא הטייס מכוונת ללילה; מהירות ההסעה הגבוהה ביותר.],
  [1.5 טיסת מבחן 1], [כל שלב 1 לבד: התנעה, קשר, הסעה, כניסה למסלול, הסעה חזרה, כיבוי.], [כל הסעיפים של תרגולים 1.1 עד 1.3.],
)

#idx("טיסת מבחן 1")טיסת מבחן 1 נטוסה ביום, בלי הוראות המדריך ובלי סימון המתגים; ה#term("פנקס") זמין כרגיל. אין בה מצב חירום. תרגול עובר כשהוא מגיע לסופו בזמן ואף סעיף אינו מקבל ציון "לא מספק"; ה#term("תחקיר") נותן את הציון של כל סעיף (@debrief).
