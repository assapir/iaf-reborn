#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("תרגולי מבנה")#idx("מספר 2")שלב 4 בקורס ההכשרה, מבנה והובלה, הוא היחיד שבו טסים עם מטוסים נוספים. ששת ה#term("תרגול", shown: "תרגולים") זהים ב-F-16D ברק, ב-F-16I סופה וב-F-35I אדיר, כל מטוס מבסיס האם שלו. ב-F-16 המדריך במושב האחורי; ב-F-35I המדריך מטיס את מטוס המוביל, או את מספר 2 כשאתם מובילים. הטיסה במבנה עצמה מתוארת במדריך הטיסה של כל מטוס; שלבי כל תרגול בתדריך שלו.

#grid-table(
  (auto, auto, 1fr),
  ([תרגול], [אתם], [התרגול]),
  [4.1 מספר 2], [כידון 1-2], [המראה במבנה לצד המוביל, ארבע אצבעות, מבנה צמוד, טור והצטרפות, נחיתה אחרי המוביל],
  [4.2 מבנה טקטי], [כידון 1-2], [מבנה מקבילי, 1,500 מטר מהמוביל; פנייה טקטית ופנייה במקום],
  [4.3 הובלת זוג], [כידון 1-1], [קשר עם ה#term("מגדל") בשם הזוג, המראה במבנה, פקודות למספר 2, נחיתת הזוג],
  [4.4 הובלת רביעייה], [כידון 1-1], [המראה בטור, מבני רביעייה, נחיתה בסדר המבנה],
  [4.5 בלילה], [כידון 1-2], [תרגול 4.1 בחושך, לפי אורות המוביל],
  [טיסת מבחן 4], [כידון 1-3], [רביעייה: מספר 3 של המוביל ומוביל של כידון 1-4],
)

=== הציון <formation-grades>

#idx("תרגולי מבנה, ציונים")הסעיפים הנבחנים ותקניהם מופיעים בתדריך של כל תרגול.

#grid-table(
  (auto, 1fr),
  ([סעיף], [מה נמדד]),
  [המרחק מהמקום במבנה], [המרחק הממוצע מהמקום, מהרגע שמגיעים לטווח 50 מטר ממנו אחרי כל פקודה; בלי הפניות הטקטיות],
  [זמן ההצטרפות], [מקריאת "הצטרפות" של המוביל ועד הגעה לטווח 50 מטר מהמקום],
  [פקודות המבנה שניתנו], [אחוז הפקודות שניתנו מתוך פקודות התרגול],
  [כל מטוסי המבנה נחתו], [כל המטוסים על הקרקע בסוף הטיסה],
)

סוף התרגול: אתם בחניה, מנוע כבוי, וכל מטוסי המבנה נחתו.

=== טיסת מבחן 4 <formation-check>

#idx("טיסת מבחן 4")טיסת מבחן 4 בוחנת את סעיפי המבנה ואת כל סעיפי שלבים 1 עד 3. המדריך נותן תדריך ו#term("תחקיר") בלבד: בלי קריאות בטיסה ובלי הדגשת מתגים; ה#term("פנקס") זמין. מצב חירום אחד, מאלה שכבר נלמדו, עלול לקרות בכל רגע, בלי הודעה מראש.
