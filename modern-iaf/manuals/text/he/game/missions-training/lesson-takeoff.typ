#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("שיעור ההמראה")ה#term("שיעור") השני של כל מטוס: משימות 2012 (סופה, רמון, מסלול 25R), 2022 (ברק, רמת דוד, מסלול 27) ו-2032 (אדיר, נבטים, מסלול 26L).

=== המטרה <lesson-takeoff-purpose>

מבצעים יציאה מלאה מול ה#term("מגדל"): ההתנעה, ארבע הקריאות, ההסעה למסלול, ההתיישרות על המסלול, ההמראה והטיפוס בכיוון המסלול עם כן נסע אסוף.

הנהלים של המטוס נמצאים במדריך שלו. ההתנעה וההמראה: #other("f16i", "cold-start"), #other("f16d", "cold-start") וכן #other("f35i", "cold-start"). התנהגות המטוס בריצת ההמראה: #other("f16i", "handling-takeoff-landing"), #other("f16d", "handling-takeoff-landing") וכן #other("f35i", "handling-takeoff-landing"). הקריאות מפורטות ב@tower-ground. הסעיף הזה מתאר מה המשחק בודק.

=== מה המשחק בודק <lesson-takeoff-objectives>

התדריך מפרט ארבעה יעדים: המראה מהמסלול של המשימה; טיפוס עם כן נסע אסוף בכיוון המסלול, עד \u{2066}10°\u{2069} לכל צד; כל זה בתוך 15 דקות מההתחלה; וכן #scr-text("obj_safe").

השיעור עובר כשכל אלה מתקיימים:

#grid-table(
  (auto, 1fr),
  ([בדיקה], [בדיוק]),
  [לכל שלב היה #term("אישור")], [ההתנעה, ההסעה, הכניסה למסלול וריצת ההמראה באו כל אחת אחרי תשובת המגדל (@scoring-clearances).],
  [המסלול הנכון], [ריצת ההמראה התחילה על המסלול של המשימה והתקדמה אל קצהו הרחוק.],
  [הריצה נשארה על המסלול], [מתחילת הריצה ועד הניתוק, מרכז המטוס נשאר במרחק של עד חצי רוחב המסלול מקו המרכז.],
  [ניתוק], [המטוס עזב את הקרקע ונשאר באוויר.],
  [הטיפוס], [ברגע כלשהו אחרי הניתוק המטוס באוויר, כן הנסע אסוף, והכיוון שלו עד \u{2066}10°\u{2069} מכיוון המסלול.],
  [בזמן], [הרגע הזה מגיע בתוך 15 דקות מתחילת הטיסה.],
  [דבר לא נכשל], [לא קרה אף אחד מהדברים שמכשילים כל משימה מיד (@scoring-at-once).],
)

מרגע שהמטוס באוויר המשחק בודק את הטיסה כל 3 שניות. כל עוד יעד נשאר פתוח, שורה בפינה העליונה של המסך מציינת אותו: "להשלמה: איסוף כן הנסע." או "להשלמה: טיפוס בכיוון המסלול עם כן נסע אסוף." כשהיעד האחרון מושג, הלוח #scr("fl_complete") נפתח (@time-pause-done). ב#term("תחקיר") כתוב אז: #scr-text("done_takeoff")

כיווני המסלולים הם \u{2066}246°\u{2069} במסלול 25R של רמון, \u{2066}265°\u{2069} במסלול 27 של רמת דוד ו-\u{2066}256°\u{2069} במסלול 26L של נבטים.

=== היעדים בתחקיר <lesson-takeoff-debrief>

#grid-table(
  (1.3fr, 1.3fr, 1fr),
  ([יעד], [הערך הנדרש], [בסטייה ממנו]),
  [המראה מהמסלול], [המסלול של המשימה.], [כישלון],
  [תוך 15 דקות מההתחלה], [15 דקות, עד רגע בדיקת הטיפוס.], [כישלון],
  [איסוף כן הנסע בכיוון המסלול], [כיוון המסלול, \u{2066}±10°\u{2069}.], [כישלון],
  [סטייה מקו המרכז בריצת ההמראה], [לכל היותר חצי רוחב המסלול.], [כישלון],
  [מהירות ניתוק מול המהירות המומלצת במשקל זה], [מהירות ההמראה המומלצת למשקל המטוס בניתוק. היא עולה עם המשקל.], [סימן ! מעבר ל-10 קשר; המשימה עוברת בכל זאת],
  [קריאות למגדל], [ארבע קריאות.], [סימן ! כשיש פחות; המשימה עוברת בכל זאת],
)

המהירות המומלצת היא מספר ללמוד ממנו: שום מהירות ניתוק אינה מכשילה את השיעור.

=== מה מכשיל אותו <lesson-takeoff-fails>

#grid-table(
  (1fr, 1.2fr, 1.2fr),
  ([מה נעשה], [מה המשחק עושה], [איך להימנע]),
  [שלב התחיל לפני האישור שלו.], [המגדל מציין אותו. המשימה נכשלת מיד (@scoring-clearances).], [להשמיע את הקריאה ולהמתין לתשובה לפני כל שלב.],
  [המטוס ירד מהמשטח הסלול בהסעה.], [המשימה נכשלת מיד: "המטוס ירד מהמשטח הסלול."], [לשמור את גלגל האף על קו ההסעה הצהוב. להאט לפני כל פנייה.],
  [הריצה התחילה על מסלול אחר.], [בהתיישרות המגדל מזהיר פעם אחת. מעל 30 קשר שם המשימה נכשלת מיד: "ההמראה לא הייתה מהמסלול שהוקצה."], [לעקוב אחרי השלטים עם מספר המסלול (@ground-signs-signs). אחרי אזהרת המגדל, לעצור ולרדת מהמסלול.],
  [המטוס יצא מהמסלול בזמן הריצה.], [המשימה נכשלת: "המטוס יצא מהמסלול בזמן ריצת ההמראה."], [להחזיק את קו המרכז בעזרת הגה הכיוון לאורך כל הריצה.],
  [הטיפוס היה עם כן נסע פרוס, או שהייתה פנייה מהכיוון לפני איסוף כן הנסע.], [שורת ההשלמה נשארת. כשעוברות 15 דקות, המשימה נכשלת.], [לאסוף את כן הנסע מיד אחרי הניתוק, בכיוון המסלול, לפני כל פנייה.],
  [עברו 15 דקות.], [חמש שניות אחר כך המשימה מסתיימת בכישלון. הסיבה מציינת את היעד הפתוח: "המטוס לא המריא.", "כן הנסע לא נאסף." או "לא בכיוון המסלול עם כן נסע אסוף."], [לבקש מהמגדל את השלב הבא מיד עם סיום הקודם.],
  [המטוס לא עזב את הקרקע.], [כשהטיסה מסתיימת, או כשהזמן אוזל, המשימה נכשלת: "המטוס לא המריא."], [לפתוח מצערת מלאה על המסלול ולהרים את האף כשהמהירות מתקרבת למהירות המומלצת.],
)

התרסקות, נזק, נטישה או שלב התנעה שלא לפי הסדר מכשילים את השיעור הזה כמו כל משימה (@scoring-at-once).

=== הסיבות הרגילות לכישלון <lesson-takeoff-usual>

- *תנועה בלי הקריאה שלה.* ארבע הקריאות הן ארבעה אישורים נפרדים. \u{2066}"Taxi to runway"\u{2069} אינו מאשר כניסה למסלול. \u{2066}"Line up"\u{2069} אינו מאשר המראה.
- *קיצור פינה בהסעה.* המשחק בודק את מרכז המטוס מול השטחים הסלולים, עם שוליים של 5 מ'. סטייה רחבה אל החול בצומת מספיקה לכישלון.
- *הסעה מהירה.* יש להאט לקשרים בודדים בכל פנייה, ולבלום לפני הפנייה.
- *התיישרות על המסלול הראשון שפוגשים.* ברמון ובנבטים יש מסלולים מקבילים זה לצד זה, וברמת דוד המסלולים מצטלבים. יש לקרוא את השלט האדום לפני הכניסה (@ground-signs-signs).
- *כן הנסע נשכח.* השיעור אינו עובר בניתוק. הוא עובר כשכן הנסע אסוף בכיוון המסלול.
