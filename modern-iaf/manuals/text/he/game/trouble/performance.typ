#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("ביצועים")#idx("טיסה מקוטעת")טיסה חלקה כשהמחשב מצייר כל תמונה בזמן. הסעיף הזה מקצר את #term("זמן תמונה", shown: "זמן התמונה") בעזרת הגדרות הגרפיקה, היקרות תחילה. כולן נמצאות במסך #scr("preferences"), בחלק #scr("graphics") (@settings-graphics), שאפשר לפתוח בזמן טיסה מתפריט ההשהיה.

=== קודם למדוד <performance-measure>

+ לטוס במשימה כלשהי לפחות 30 שניות.
  #then[הטיסה מודדת את זמן התמונה שלה בין השנייה ה-10 לשנייה ה-30.]
+ לפתוח את #scr("preferences"), חלק #scr("graphics"), ולהצביע על שורת גרפיקה כלשהי.
  #then[החלונית מציגה את זמן התמונה שנמדד על פס, עם קו ב-60 תמונות בשנייה (@settings-frame).]

פס שמסתיים לפני הקו מהיר מספיק. פס שעובר את הקו הוא טיסה בפחות מ-60 תמונות בשנייה; בקצה הפס, 33 מ"ש, אלה כ-30.

#note[הטיסה הראשונה אחרי עדכון נטענת לאט, בזמן שהמשחק מכין את הגרפיקה פעם אחת (@after-update-slow). יש למדוד בטיסה שנייה.]

=== הדרך המהירה: הערכה למחשב נייד <performance-laptop>

#idx("ערכה למחשב נייד")
+ בשורה #scr("preset"), לבחור #scr("preset_laptop").
  #then[שבע הגדרות משתנות בבת אחת: התמונה מצוירת קטנה יותר ומוגדלת, הצללים למרחק, המבנים והעצים כבויים, והקרקע הרחוקה מצוירת בפירוט נמוך יותר (@settings-presets).]
+ לטוס שוב ולקרוא את זמן התמונה שנמדד.

#scr("preset_laptop") מיועדת לגרפיקה המובנית של מחשב נייד. כשהטיסה חלקה איתה, אפשר לעלות אל #scr("preset_balanced"), שמחזירה את המבנים והעצים.

=== הדרך האיטית: הגדרה אחת בכל פעם <performance-order>

בכל שורת גרפיקה יש #term("תווית העלות", shown: "תווית עלות") (@settings-cost). יש להנמיך את ההגדרות בסדר הזה, ולמדוד אחרי כל שינוי. אחרי שינוי החלונית מציגה גם אומדן להגדרות הנוכחיות, עוד לפני הטיסה.

+ לחפש שורה שבתווית שלה כתוב #scr("cost_high") או #scr("cost_medium"), ולבחור בה את האפשרות הפשוטה.
  #then[לפי העלויות שנמדדו אלה #scr("scenery") במצב #scr("scenery_detailed") (לבחור #scr("on")) וכן #scr("clouds") במצב #scr("clouds_volumetric") (לבחור #scr("clouds_original")).]
+ לקבוע את #scr("upscaling") למצב #scr("upscaling_quality"), ואחר כך למצב #scr("upscaling_balanced").
  #then[במצב #scr("upscaling_balanced") כתוב בתווית #scr("cost_saves"). העולם מצויר בפחות פיקסלים; הטקסט בתא הטייס נשאר חד.]
+ לכבות את #scr("shadow_reach").
+ לקבוע את #scr("scenery") למצב #scr("off").
+ לכבות את #scr("shadows").
+ להנמיך את #scr("terrain_detail").

=== הגדלת רזולוציה <performance-upscaling>

#idx("הגדלת רזולוציה")#scr-text("upscaling_about")

#scr("upscaling") היא ההגדרה עם החיסכון הגדול ביותר שמשאירה כל אפקט פועל. במחשב הנייד שבו נערכו המדידות #scr("upscaling_quality") חסכה כ-3 מ"ש לתמונה, ו-#scr("upscaling_balanced") כ-6.6 מ"ש, מתוך 30 מ"ש.

=== הגדרות שאינן עולות בזמן תמונה <performance-not>

- #scr("fullscreen") וכן #scr("vsync") אינן עולות בזמן ציור; בתוויות שלהן כתוב #scr("cost_none"). #scr("vsync") מצמידה את המשחק לקצב של המסך.
- גם הגדרות השמע וההתקנים אינן עולות בזמן תמונה.

כשהטיסה איטית גם עם #scr("preset_laptop"), יש לדווח על כך עם זמן התמונה שנמדד וקובץ היומן (@crash-page-report).
