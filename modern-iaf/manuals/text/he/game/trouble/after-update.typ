#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("עדכון")עדכון הוא גרסה חדשה יותר של תיקיית המשחק. הוא יכול לשנות את תוכנת המשחק ואת הקבצים שמהם נבנים נתוני המשחק. הסעיף הזה מתאר מה לעשות אחרי עדכון.

=== מה עדכון דורש <after-update-what>

#grid-table(
  (auto, 1fr),
  ([חלק], [מה מעדכן אותו]),
  [תוכנת המשחק], [המשחק בונה את מה שהשתנה בכל הפעלה שלו (@start-game). לכן ההפעלה הראשונה אחרי עדכון ארוכה יותר.],
  [נתוני המשחק], [#term("אשף ההתקנה"). כל שלב זוכר ממה נבנה. בשלב שהקלט שלו השתנה בעדכון כתוב #stp("state_will_run"); באחרים כתוב #stp("state_up_to_date") והם מדולגים.],
  [ההורדות], [הן נשמרות. ההתקנה שומרת כל קובץ שהורד לפי שמו ומשתמשת בו שוב, כך שכל קובץ יורד פעם אחת.],
  [הפרופילים, הטיסות וההגדרות], [הם נשמרים כפי שהם, בתיקיית המשתמש, מחוץ לתיקיית המשחק (@start-game-files).],
)

=== עדכון הנתונים <after-update-data>

#idx("התקנה, אחרי עדכון")
+ לפתוח את "הזרוע הארוכה — התקנה" (@setup-start).
+ להמשיך לעמוד #stp("page_install").
  #then[אחרי בדיקה קצרה כל שורה מציגה אם השלב שלה מעודכן או ירוץ.]
+ לבחור #stp("install").
  #then[רצים רק השלבים שהקלט שלהם השתנה. רובם נמשכים שניות. שלב הקרקע נבנה מחדש מהקבצים שהורדו כשהקלט שלו השתנה.]
+ לבחור #stp("start_game") בעמוד #stp("page_done").

#note[המשחק אינו מריץ את שלבי ההתקנה מעצמו כל עוד המשימות קיימות. יש לפתוח את ההתקנה אחרי כל עדכון, כדי שאף שלב לא יישאר מאחור.]

=== מקשים, צלילים או קולות חדשים שחסרים <after-update-own>

#idx("מקשים, חסרים אחרי עדכון")השלב #stp("step_sim-own") בונה את טבלת המקשים, את הצלילים ואת קולות הקשר שהמשחק קורא. אחרי עדכון שמוסיף פקודה, צליל או שורת קשר, הם קיימים במשחק רק אחרי שהשלב הזה רץ שוב: עד אז פקודה חדשה עלולה להיות בלי מקש, וצליל חדש או שורת קול חדשה עלולים לשתוק.

+ להריץ את ההתקנה כמו ב@after-update-data.
  #then[בשורה #stp("step_sim-own") כתוב #stp("state_will_run"), היא רצה כמה שניות, ואז כתוב בה #stp("state_done").]

כשבשורה כתוב #stp("state_up_to_date") והתקלה נשארת, יש לסמן #stp("row_redo") בשורה ולבחור #stp("install") (@setup-faults-again).

=== הדת"ק מודיע שאין משימות <after-update-no-missions>

#idx("אין משימות")בכרטיס שב#term("דת\"ק"), או במסך #scr("missions"), כתוב: #scr-text("no_missions") מתחתיו המסך מציין פקודת התקנה; יש לפתוח במקומה את פריט ההתקנה (@setup-start). #scr("fly") והחלקים של המסך מעומעמים.

#screen("nodata_missions", [המסך #scr("missions") בלי נתוני המשחק.], width: 80%)

הסיבה: השלב #stp("step_sim-missions") לא נבנה, או שהנתונים שלו הוסרו.

+ לסגור את המשחק.
+ לפתוח את "הזרוע הארוכה — התקנה" (@setup-start).
+ לבחור #stp("install") בעמוד #stp("page_install") ולהמתין לעמוד #stp("page_done").
+ לבחור #stp("start_game").
  #then[הכרטיס שבדת"ק אינו מציג הודעת התקנה, והלחצן #scr("fly") פעיל.]

=== הטיסה הראשונה אחרי עדכון נטענת לאט <after-update-slow>

#idx("טעינה, איטית")בזמן טעינת טיסה עשויה להופיע מתחת למד שורה: #scr-text("loading_slow")

המשחק מכין את תוכניות הגרפיקה לכרטיס המסך של המחשב בפעם הראשונה שכל אחת מהן מצוירת, ושומר אותן להפעלה הבאה. אחרי עדכון, או בטיסה הראשונה בכלל, העבודה הזו נעשית שוב, והמד עלול לעמוד זמן מה; ב-Mac זה עשוי להימשך כמה דקות. יש להמתין: הטיסות הבאות נטענות בשניות.

מסך הטעינה והתקלות שלו מתוארים ב@loading. כשהטעינה אינה מתקדמת כלל, המשחק פותח את #term("דף התקלה") (@crash-page).
