#import "/modern-iaf/manuals/layout/manual.typ": *

הסעיף הזה עוסק במקשים שפועלים על המשחק עצמו בזמן טיסה: תפריט ההשהיה, מקש ההשהיה, מהירות הזמן, הקול, והדרכים שבהן טיסה מסתיימת.

=== תפריט ההשהיה <time-pause-menu>

#idx("תפריט ההשהיה")
+ ללחוץ על #keycap("Esc") בזמן טיסה.
  #then[הטיסה קופאת ותפריט ההשהיה נפתח מעליה: #scr("paused"), עם המשימה והמטוס.]

#screen("flight_pause", [תפריט ההשהיה.])

#grid-table(
  (auto, 1fr),
  ([שורה], [מה היא עושה]),
  [#scr("resume")], [סוגרת את התפריט. הטיסה נמשכת מהמקום שבו קפאה. #keycap("Esc") עושה אותו דבר.],
  [#scr("preferences")], [פותחת את ההגדרות מעל הטיסה הקפואה (@settings), עם המסכים #scr("keys_screen") וכן #scr("joystick_screen") (@keys-joystick). #keycap("Esc") מחזיר לתפריט ההשהיה. השינויים חלים עם החזרה: גרפיקה, שמע, מקשים ושפה.],
  [#scr("end_flight")], [מסיימת את הטיסה עכשיו (@time-pause-leave).],
  [#scr("quit_desktop")], [שואלת #scr("quit_q") ואחרי תשובה חיובית סוגרת את המשחק.],
)

=== מקש ההשהיה <time-pause-key>

#idx("השהיה")#key("Pause") מקפיא את הטיסה ואת הצלילים שלה בלי תפריט. סימן השהיה מהבהב מוצג במסך. לחיצה נוספת על המקש, או על #keycap("Esc"), ממשיכה את הטיסה.

=== מהירות הזמן <time-pause-speed>

#idx("מהירות הזמן")קטע טיסה ארוך עובר מהר יותר כשהשעון מואץ.

#grid-table(
  (auto, 1fr),
  ([מקש], [מה הוא עושה]),
  [#key("Cycle time speed x1 / x2 / x4")], [כל לחיצה מעבירה את השעון שלב: פי שניים, פי ארבעה, ושוב מהירות רגילה.],
  [#key("Real-time speed")], [מחזיר את השעון למהירות רגילה מיד.],
)

המטוס ושעון המשימה רצים מהר יותר.

#caution[בשעון מואץ המטוס מגיב להיגוי במהירות השעון. קרוב לקרקע או למטוס אחר תנועה קטנה הופכת לגדולה. לפני המראה, נחיתה או קרב יש לחזור למהירות רגילה עם #key("Real-time speed").]

=== הקול <time-pause-mute>

#idx("השתקה")#key("Mute / unmute sound") משתיק את כל צלילי המשחק, ולחיצה שנייה מחזירה אותם. זו ההגדרה #scr("mute") שבהגדרות #scr("sound") (@settings).

=== יציאה מטיסה <time-pause-leave>

כדי לצאת מטיסה בכל רגע:

+ ללחוץ על #keycap("Esc").
+ לבחור #scr("end_flight").
  #then[הטיסה מסתיימת, וה#term("דת\"ק") נפתח.]

=== נטישה <time-pause-eject>

#idx("נטישה, במשחק")#warning[נטישה מסיימת את הטיסה. המקש פועל בכל רגע, גם על הקרקע, כל עוד המטוס שלם: אחרי שהמטוס התפוצץ באוויר המקש אינו עושה דבר, והטיסה מסתיימת 5 שניות אחר כך. נדרשות שלוש לחיצות, כדי שלחיצה מקרית אחת לא תעשה דבר.]

+ ללחוץ שלוש פעמים על #key("Eject (press 3 times)").
  #then[הכיסא עוזב את המטוס. כל הצלילים והקשר נפסקים. המבט נשאר בחוץ, על הכיסא ועל המטוס.]

הטיסה הסתיימה, והדת"ק נפתח. מתי לנטוש את המטוס מתואר במדריך שלו: #other("f16i", "ejection"), #other("f16d", "ejection") וכן #other("f35i", "ejection").
