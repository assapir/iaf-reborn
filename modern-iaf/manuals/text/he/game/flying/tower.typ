#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("מגדל")#idx("קריאות קשר")על הקרקע כל שלב ב#term("שיעור") ממתין ל#term("מגדל"): התנעת המנוע, ההסעה, הכניסה למסלול וההמראה. הטייס מבקש, המגדל עונה, ותשובתו היא ה#term("אישור"). הסעיף הזה מפרט את הקריאות לפי הסדר. מה המשחק עושה כשזזים בלי אישור מתואר ב@scoring-clearances.

המדריך של כל מטוס מפרט את הנוהל שבין הקריאות. להתנעה ולהמראה: #other("f16i", "cold-start"), #other("f16d", "cold-start") וכן #other("f35i", "cold-start"). לנחיתה: #other("f16i", "landing"), #other("f16d", "landing") וכן #other("f35i", "landing").

=== מקש הקריאה למגדל והתפריט שלו <tower-menu>

#idx("קריאה למגדל")
+ ללחוץ על #key("Call the tower").
  #then[רשימה קצרה וממוספרת נפתחת בפינה העליונה של המסך, מתחת לשם המגדל שאיתו מדברים.]
+ ללחוץ על המספר של קריאה.
  #then[הרשימה נסגרת. הטייס משמיע את הקריאה. המגדל עונה.]

כל מקש אחר סוגר את הרשימה בלי קריאה. הרשימה נסגרת גם מעצמה אחרי 6 שניות.

הרשימה מכילה את הקריאות שמתאימות לרגע:

#grid-table(
  (auto, auto, 1fr),
  ([היכן המטוס], [מספר], [קריאה]),
  [על הקרקע], [1], [בקשת התנעה],
  [], [2], [בקשת הסעה],
  [], [3], [בקשת כניסה למסלול],
  [], [4], [בקשת המראה],
  [באוויר], [1], [קריאה למגדל (נחיתה)],
)

המגדל שעונה הוא של הבסיס הקרוב ביותר, עד מרחק של כ-18 ק״מ.

=== הקריאות על הקרקע, לפי הסדר <tower-ground>

#idx("אישור התנעה")#idx("אישור הסעה")#idx("אישור כניסה למסלול")#idx("אישור המראה")אות הקריאה הוא Alpha. המסלול שבתשובות המגדל הוא המסלול של המשימה.

#caution[שלב שמתחיל לפני אישור המגדל מכשיל משימת אימון מיד. יש להשמיע כל קריאה ולהמתין לתשובה לפני שמבצעים את מה שהיא מאשרת (@scoring-clearances).]

+ כשהמנוע כבוי, בעמדת החניה, ללחוץ על #key("Call the tower") ואז על #keycap("1").
  #then[המגדל עונה \u{2066}"Alpha, cleared to start"\u{2069}. מותר להתניע את המנוע.]
+ להתניע את המטוס לפי הבד״ח שלו (@notebook-checklist). להמתין עד שהמנוע בסרק והאוויוניקה פועלת.
+ ללחוץ על #key("Call the tower") ואז על #keycap("2").
  #then[המגדל עונה בברכה ובמילים \u{2066}"taxi to runway"\u{2069} עם מספר המסלול. מותר לעזוב את עמדת החניה.]
+ להסיע אל המסלול ולעצור ב#term("נקודת המתנה", shown: "נקודת ההמתנה"), לפני המסלול (@ground-signs-hold).
+ ללחוץ על #key("Call the tower") ואז על #keycap("3").
  #then[המגדל עונה \u{2066}"line up runway"\u{2069} עם מספר המסלול והרוח. מותר להיכנס למסלול.]
+ להסיע אל המסלול ולעצור על קו המרכז שלו, עם האף לאורך המסלול.
+ ללחוץ על #key("Call the tower") ואז על #keycap("4").
  #then[המגדל עונה \u{2066}"cleared for take-off"\u{2069}. מותר להתחיל בריצת ההמראה.]

אישור שהתקבל נשמר, גם כשמכבים את המנוע ומתניעים אותו שוב.

=== שאר התשובות של המגדל <tower-answers>

#idx("Hold position")#grid-table(
  (1fr, 1.3fr),
  ([המגדל אומר], [המשמעות, ומה לעשות]),
  [\u{2066}"hold position"\u{2069}], [המגדל אינו יכול לאשר את הבקשה עכשיו. אין אישור. סיבות אופייניות: בקשת הסעה כשהמנוע אינו פועל; בקשת כניסה למסלול רחוק מהמסלול או כשהמסלול תפוס. יש לתקן את הסיבה ולקרוא שוב.],
  [\u{2066}"negative, hold position, request ... first"\u{2069}], [קריאה דולגה: המראה לפני כניסה למסלול, כניסה למסלול לפני הסעה, או הסעה לפני התנעה. יש להשמיע את הקריאה שהמגדל מציין, ואחריה את זו.],
  [\u{2066}"line up runway ..."\u{2069} בתשובה לבקשת המראה], [המראה התבקשה לפני ההתיישרות על המסלול. התשובה מאשרת רק את הכניסה למסלול. יש להתיישר על המסלול ולבקש המראה שוב.],
  [\u{2066}"you are on runway ..., the assigned runway is ..."\u{2069}], [ההתיישרות הייתה על מסלול שאינו המסלול של המשימה. יש לרדת ממנו ולהסיע אל המסלול שהוקצה. ריצת המראה על המסלול השגוי מכשילה את המשימה.],
  [\u{2066}"engine start without clearance", "taxi without clearance", "runway entry without clearance", "take-off without clearance"\u{2069}], [הפעולה בוצעה לפני האישור שלה. במשימת אימון המשימה נכשלה.],
)

קריאה שגויה או חוזרת אינה עולה דבר. קריאה חוזרת מקבלת שוב את התשובה שלה.

=== קריאת הנחיתה <tower-landing>

#idx("קריאת נחיתה")באוויר יש ברשימה קריאה אחת.

+ ללחוץ על #key("Call the tower") ואז על #keycap("1").
  #then[הטייס מבקש נחיתה מהבסיס הקרוב ביותר. המגדל עונה \u{2066}"proceed to runway"\u{2069} עם המסלול לנחיתה.]

למגדל עדיין אין קריאות להצטרפות להקפה, לגישה הסופית או להליכה סביב.

=== התדרים: הלשונית קשר <tower-radio>

#idx("תדרים")#idx("GND")#idx("TWR")הלשונית #scr("nb_radio") של ה#term("פנקס") (@notebook-tabs) מפרטת, לבסיס של המשימה:

- #scr("nb_callsign"): אות הקריאה;
- תדרי הבסיס ב-MHz: GND (בקרת הקרקע), TWR (המגדל) וכן APP (הגישה);
- כל קריאה בטור #scr("nb_you_call"), התדר שלה בטור #scr("nb_on"), והתשובה שיש להמתין לה בטור #scr("nb_answer").

#grid-table(
  (auto, auto, auto, auto),
  ([בסיס], [GND], [TWR], [APP]),
  [רמון], [275.8], [251.15], [120.9],
  [רמת דוד], [285.25], [118.6], [125.8],
  [נבטים], [264.35], [240.25], [120.9],
  [חצרים], [268.7], [256.9], [122.15],
)

הדף מציב את קריאות ההתנעה וההסעה ב-GND ואת קריאות הכניסה למסלול, ההמראה והנחיתה ב-TWR. תדרי ה-APP של רמון ושל נבטים ותדרי ה-TWR וה-APP של רמת דוד הם התדרים שפורסמו. האחרים הם של הסימולטור.

#note[בסימולטור המקש #key("Call the tower") מגיע למגדל בכל תדר שמכשיר הקשר של המטוס מכוון אליו, וקול של בקר אחד עונה לכל הקריאות. כיוון מכשירי הקשר הוא נוהל של המטוס: #other("f16i", "radios"), #other("f16d", "radios") וכן #other("f35i", "radios").]

#screen("notebook_radio", [הלשונית #scr("nb_radio") ברמון.])

=== שורות הקשר במסך <tower-subtitles>

#idx("כתוביות הקשר")כל קריאה ותשובה נשמעות בקול, ומוצגות כשורת טקסט במרכז ראש המסך ברגע שהקול מתחיל. הפס מחזיק את שלוש השורות החדשות ביותר, כל אחת למשך 8 שניות. קודם באה הקריאה של הטייס, אחרי הפסקה קצרה תשובת המגדל, ואז ה-\u{2066}"Roger"\u{2069} של הטייס.

השורות כתובות בשפת המשחק (@language). הקולות מדברים אנגלית.

#screen("flight_band", [קריאה למגדל: שורות הקשר בראש המסך.])
