#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("מגדל")#idx("קריאות קשר")על הקרקע כל שלב ב#term("שיעור") ממתין ל#term("מגדל"): התנעת המנוע, ההסעה, הכניסה למסלול וההמראה. הטייס מבקש, המגדל עונה, ותשובתו היא ה#term("אישור"). הסעיף הזה מפרט את הקריאות לפי הסדר. מה המשחק עושה כשזזים בלי אישור מתואר ב@scoring-clearances.

המדריך של כל מטוס מפרט את הנוהל שבין הקריאות. להתנעה ולהמראה: #other("f16i", "cold-start"), #other("f16d", "cold-start") וכן #other("f35i", "cold-start"). לנחיתה: #other("f16i", "landing"), #other("f16d", "landing") וכן #other("f35i", "landing").

=== מקש הקריאה למגדל והתפריט שלו <tower-menu>

#idx("קריאה למגדל")
+ ללחוץ על #key("Call the tower").
  #then[רשימה קצרה וממוספרת נפתחת בפינה העליונה של המסך, מתחת לשם המגדל שאיתו מדברים.]
+ ללחוץ על המספר של קריאה.
  #then[הרשימה נסגרת. הטייס משמיע את הקריאה. המגדל עונה.]

כל מקש אחר סוגר את הרשימה בלי קריאה. הרשימה נסגרת גם מעצמה אחרי 6 שניות.

הרשימה מכילה את הקריאות שמתאימות לרגע:

#grid-table(
  (auto, auto, 1fr),
  ([היכן המטוס], [מספר], [קריאה]),
  [על הקרקע], [1], [בקשת התנעה],
  [], [2], [בקשת הסעה],
  [], [3], [בקשת כניסה למסלול],
  [], [4], [בקשת המראה],
  [באוויר], [1], [קריאה למגדל (נחיתה)],
)

המגדל שעונה הוא של הבסיס הקרוב ביותר, עד מרחק של כ-18 ק"מ.

=== הקריאות על הקרקע, לפי הסדר <tower-ground>

#idx("אישור התנעה")#idx("אישור הסעה")#idx("אישור כניסה למסלול")#idx("אישור המראה")אות הקריאה הוא כידון 1 (בשיטת כידון: המבנה הראשון כידון 1, הבא כידון 2, ומטוסי המבנה כידון 1-1, 1-2 וכן הלאה). המסלול שבתשובות המגדל הוא המסלול של המשימה.

#caution[שלב שמתחיל לפני אישור המגדל מכשיל משימת אימון מיד. יש להשמיע כל קריאה ולהמתין לתשובה לפני שמבצעים את מה שהיא מאשרת (@scoring-clearances).]

+ כשהמנוע כבוי, בעמדת החניה, ללחוץ על #key("Call the tower") ואז על #keycap("1").
  #then[המגדל עונה \u{2066}"Kidon 1, cleared to start"\u{2069}. יש אישור להתניע את המנוע.]
+ להתניע את המטוס לפי הבד"ח שלו (@notebook-checklist). להמתין עד שהמנוע בסרק והאוויוניקה פועלת.
+ ללחוץ על #key("Call the tower") ואז על #keycap("2").
  #then[המגדל עונה בברכה ובמילים \u{2066}"taxi to runway"\u{2069} עם מספר המסלול. יש אישור לעזוב את עמדת החניה.]
+ להסיע אל המסלול ולעצור ב#term("נקודת המתנה", shown: "נקודת ההמתנה"), לפני המסלול (@ground-signs-hold).
+ ללחוץ על #key("Call the tower") ואז על #keycap("3").
  #then[המגדל עונה \u{2066}"line up runway"\u{2069} עם מספר המסלול והרוח. יש אישור להיכנס למסלול.]
+ להסיע אל המסלול ולעצור על קו המרכז שלו, עם האף לאורך המסלול.
+ ללחוץ על #key("Call the tower") ואז על #keycap("4").
  #then[המגדל עונה \u{2066}"cleared for take-off"\u{2069}. יש אישור להתחיל בריצת ההמראה.]

אישור שהתקבל נשמר, גם כשמכבים את המנוע ומתניעים אותו שוב.

=== שאר התשובות של המגדל <tower-answers>

#idx("Hold position")#grid-table(
  (1fr, 1.3fr),
  ([המגדל אומר], [המשמעות, ומה לעשות]),
  [\u{2066}"hold position"\u{2069}], [המגדל אינו יכול לאשר את הבקשה עכשיו. אין אישור. סיבות אופייניות: בקשת הסעה כשהמנוע אינו פועל; בקשת כניסה למסלול רחוק מהמסלול או כשהמסלול תפוס. יש לתקן את הסיבה ולקרוא שוב.],
  [\u{2066}"negative, hold position, request ... first"\u{2069}], [קריאה דולגה: המראה לפני כניסה למסלול, כניסה למסלול לפני הסעה, או הסעה לפני התנעה. יש להשמיע את הקריאה שהמגדל מציין, ואחריה את זו.],
  [\u{2066}"line up runway ..."\u{2069} בתשובה לבקשת המראה], [המראה התבקשה לפני ההתיישרות על המסלול. התשובה מאשרת רק את הכניסה למסלול. יש להתיישר על המסלול ולבקש המראה שוב.],
  [\u{2066}"you are on runway ..., the assigned runway is ..."\u{2069}], [ההתיישרות הייתה על מסלול שאינו המסלול של המשימה. יש לרדת ממנו ולהסיע אל המסלול שהוקצה. ריצת המראה על המסלול השגוי מכשילה את המשימה.],
  [\u{2066}"engine start without clearance", "taxi without clearance", "runway entry without clearance", "take-off without clearance"\u{2069}], [הפעולה בוצעה לפני האישור שלה. במשימת אימון המשימה נכשלה.],
)

קריאה שגויה או חוזרת אינה עולה דבר. קריאה חוזרת מקבלת שוב את התשובה שלה.

=== קריאת הנחיתה <tower-landing>

#idx("קריאת נחיתה")באוויר יש ברשימה קריאה אחת.

+ ללחוץ על #key("Call the tower") ואז על #keycap("1").
  #then[הטייס מבקש נחיתה מהבסיס הקרוב ביותר. המגדל עונה \u{2066}"proceed to runway"\u{2069} עם המסלול לנחיתה.]

למגדל עדיין אין קריאות אליכם להצטרפות להקפה, לגישה הסופית או להליכה סביב.

#idx("מספרים, קריאות נחיתה")בשיעור הרביעייה שומעים גם את המגדל מדבר עם המספרים כשכל אחד חוזר: "כידון 1-2, אישור נחיתה במסלול ..." כשהוא פונה לגישה הסופית ו"כידון 1-2, ברוכים השבים, הסעה לחנייה" אחרי ריצת הנחיתה. כל אחד עונה באות הקריאה שלו. הקריאות האלה לא דורשות דבר מכם (@lesson-four-ship-home).

=== התדרים: הלשונית קשר <tower-radio>

#idx("תדרים")#idx("GND")#idx("TWR")הלשונית #scr("nb_radio") של ה#term("פנקס") (@notebook-tabs) מפרטת, לבסיס של המשימה:

- #scr("nb_callsign"): אות הקריאה;
- תדרי הבסיס ב-MHz: GND (בקרת הקרקע), TWR (המגדל) וכן APP (הגישה);
- כל קריאה בטור #scr("nb_you_call"), התדר שלה בטור #scr("nb_on"), והתשובה שיש להמתין לה בטור #scr("nb_answer").

#grid-table(
  (auto, auto, auto, auto),
  ([בסיס], [GND], [TWR], [APP]),
  [רמון], [275.8], [251.15], [120.9],
  [רמת דוד], [285.25], [118.6], [125.8],
  [נבטים], [264.35], [240.25], [120.9],
  [חצרים], [268.7], [256.9], [122.15],
)

הדף מציב את קריאות ההתנעה וההסעה ב-GND ואת קריאות הכניסה למסלול, ההמראה והנחיתה ב-TWR. תדרי ה-APP של רמון ושל נבטים ותדרי ה-TWR וה-APP של רמת דוד הם התדרים שפורסמו. האחרים הם של הסימולטור.

#note[בסימולטור המקש #key("Call the tower") מגיע למגדל בכל תדר שמכשיר הקשר של המטוס מכוון אליו, וקול של בקר אחד עונה לכל הקריאות. כיוון מכשירי הקשר הוא נוהל של המטוס: #other("f16i", "radios"), #other("f16d", "radios") וכן #other("f35i", "radios").]

#screen("notebook_radio", [הלשונית #scr("nb_radio") ברמון.])

=== שורות הקשר במסך <tower-subtitles>

#idx("כתוביות הקשר")כל קריאה ותשובה נשמעות בקול, ומוצגות כשורת טקסט במרכז ראש המסך ברגע שהקול מתחיל. הפס מחזיק את שלוש השורות החדשות ביותר, כל אחת למשך 8 שניות. קודם באה הקריאה של הטייס, אחרי הפסקה קצרה תשובת המגדל, ואז ה-\u{2066}"Roger"\u{2069} של הטייס.

השורות והקולות הם בשפת המשחק (@language).

#screen("flight_band", [קריאה למגדל: שורות הקשר בראש המסך.])

=== פקודות למספרים <radio-flight>

#idx("מספרים")#idx("תפריט הקשר")בשיעור רביעייה הטייס הוא כידון 1-1 ומוביל את כידון 1-2, 1-3 ו-1-4. כידון 1-2 טס על המוביל; כידון 1-4 טס על כידון 1-3, שמוביל את הזוג השני. הפקודות ניתנות מאותו תפריט; לארבע פקודות יש גם מקש משלהן (מתחת לטבלה).

+ ללחוץ על #key("Call the tower").
  #then[הרשימה מציגה 1 מגדל, 2 המבנה ו-3 #term("AWACS"). קריאות המגדל תחת 1. ל-AWACS אין קריאה לבצע: הוא מדווח מעצמו, ולכן השורה שלו מעומעמת.]
+ ללחוץ על 2.
  #then[מופיעים "כידון 1" (הרביעייה), "כידון 1, זוג 3–4", "כידון 1-2", "כידון 1-3" ו"כידון 1-4".]
+ ללחוץ על המספר של מי שקוראים לו.
  #then[הרשימה מציגה את הפקודות אליו. #keycap("0") חוזר אחורה. רשימה של יותר מתשע שורות מציגה את שמונה הראשונות ו-9 עוד, שמציג את השאר.]
+ ללחוץ על המספר של פקודה.
  #then[הרשימה נסגרת. הטייס משמיע את הקריאה ("כידון 1-2, הצטרפות"). כל מספר עונה באות הקריאה שלו ("כידון 1-2") או "אין אפשרות".]

אפשר גם ללחוץ בעכבר על שורה ברשימה.

#grid-table(
  (auto, auto, 1fr),
  ([פקודה], [אל], [מה המספרים עושים]),
  [מבנה], [הרביעייה], [עמוד של מבנים: מבנה ארבע אצבעות, מבנה מקבילי, מבנה טור, מבנה אלכסון ימין, מבנה אלכסון שמאל, מבנה יהלום, מבנה וי, מבנה דלתא. כל מספר קורא "במקום" במקומו החדש. השורה האחרונה, מרווחים, פותחת את מבנה צמוד ואת להגדיל מרווחים.],
  [מבנה צמוד], [הרביעייה], [המבנים הצפופים מתהדקים בשלב אחד: מ-60 מטר בין המקומות במבנה הרגיל ל-30 מטר, ואז ל-12 מטר, 2 מטר בין קצות הכנפיים. כל מספר קורא "במקום" במרווח החדש. ב-12 מטר, במבנה מקבילי או במבנה טור התשובה "אין אפשרות". מבנה חדש שומר על המרווח. ב-12 מטר יש לטוס בעדינות: בהטיה של יותר מ-35 מעלות, בגלגול מהיר או במשיכה לעומס של יותר מ-1.5 g, המספרים מתרחקים מעצמם ל-30 מטר, וחוזרים להיצמד 5 שניות אחרי שהטיסה שוב עדינה.],
  [להגדיל מרווחים], [הרביעייה], [שלב אחד חזרה לכיוון 60 המטר של המבנה הרגיל. במבנה הרגיל התשובה "אין אפשרות".],
  [הצטרפות], [כולם], [חזרה למקום במבנה מכל משימה, גם אחרי חזרה לבסיס. אל זוג 3–4 היא מסיימת פיצול.],
  [פיצול], [זוג 3–4], [הזוג השני טס לנקודת החיישן (הנקודה שהמכ"ם סימן, אחרת נקודת הניווט) ומקיף אותה. הנקודה חייבת להיות עד 40 ק"מ מהמוביל, אחרת התשובה "אין אפשרות"; גם בלי נקודת חיישן התשובה "אין אפשרות".],
  [תקיפת המטרה שלי], [כולם], [נלחמים במטוס שהמכ"ם נעול עליו: מסלול התנגשות, טיל בתוך המעטפת, פנייה הצידה בזמן שהטיל טס, ואז קרב אוויר ותותח. בלי חימוש התשובה "אין אפשרות". כשהוא מושמד, מצטרפים חזרה. מספר 4 נשאר עם מספר 3. כדי לתת לכל אחד מטוס משלו, יש לנעול על מטוס אחד ולתת אותו לכידון 1-2, ואז לנעול על מטוס אחר ולתת אותו לזוג 3–4. בלי מטוס נעול תוקפים את מטרת הקרקע של המוביל: יחידת קרקע של האויב שהמכ"ם נעול עליה, אחרת הקרובה ביותר לנקודת החיישן (עד 500 מטר), אחרת הנקודה עצמה. בלי נקודת חיישן (שום דבר לא סומן, אין נקודת ניווט והפוד לא מכוון לקרקע) התשובה "אין אפשרות". כל מספר עם פצצות תוקף בתורו, בזה אחר זה: צלילה לפצצות רגילות, יעף ישר לפצצות מונחות. מספר בלי פצצות עונה "אין אפשרות". מול מטרה נעה, כמו רכב בשיירה, כל מספר מכוון למקום שבו היא תהיה כשהפצצות יפגעו.],
  [חלוקת מטרות], [הרביעייה], [מחלקים ביניהם את מטוסי האויב שמישהו ברביעייה רואה. מטוסים במרחק עד 3 מייל ימי זה מזה הם קבוצה אחת. שתי קבוצות זו לצד זו: הזוג שמשמאל לוקח את הקבוצה השמאלית. שתי קבוצות זו מאחורי זו: הזוג של המוביל לוקח את הקרובה, הזוג השני את הרחוקה. כל זוג מחלק את הקבוצה שלו באותו אופן, מטוס מול מטוס. מספר 3 עונה "יש מטרה" ותוקף. מספרים 2 ו-4 עונים, נשארים עם מוביל הזוג ולא יורים עד שהמוביל יורה או עד שיש עליהם איום. כשאף אחד לא רואה מטוס, התשובה "אין אפשרות".],
  [אש חופשית], [כולם], [צדים כל מטוס אויב עד 20 מייל ימי מנקודת החיישן (הנקודה שהמכ"ם סימן, אחרת נקודת הניווט), כל אחד מטוס שאין לאחר; כשאין שם מטוס, מקיפים את הנקודה. מספר 4 נשאר עם מספר 3 ונלחם במטוס האחר בקבוצה שלו. הנקודה חייבת להיות עד 40 ק"מ מהמוביל, אחרת התשובה "אין אפשרות"; בלי נקודת חיישן הם צדים סביב המוביל. דלק ג'וקר או הצטרפות מסיימים את הציד.],
  [גובה נמוך], [הרביעייה], [כשהם טסים לבד (פיצול, הצטרפות, פנייה מאיום, תקיפת קרקע) הם טסים 300 רגל מעל הקרקע שלפניהם. בקרב אוויר הם טסים בגבהים של הקרב עצמו. במקום במבנה הם שומרים על הגובה של המוביל, ולכן על המוביל לטוס נמוך גם כן. יעף עם פצצות נכנס נמוך, מטפס 4 מייל ימי מהמטרה לצלילה עליה ויוצא נמוך.],
  [חזרה לגובה], [הרביעייה], [כשהם טסים לבד, הם חוזרים לגבהים הרגילים שלהם.],
  [חיפוי], [כולם], [נשארים במקום במבנה ונלחמים במטוס אויב שתוקף את המוביל: המכ"ם שלו נעול על המוביל, או שהוא מאחורי המוביל ומכוון אליו. הצטרפות או חזרה לבסיס מסיימות את החיפוי.],
  [חזרה לבסיס], [כולם], [חוזרים לבסיס ונוחתים.],
  [בדיקת קשר], [כולם], [כל מספר עונה במספרו.],
  [בדיקת מערכות ודלק], [כולם], [כל מספר עונה בכמות הדלק, באלפי ליברות ("שתיים, שש נקודה שתיים").],
)

המקשים: #key("Wingman: attack my target") נותן לכידון 1-2 תקיפת המטרה שלי, #key("Flight: sort") נותן חלוקת מטרות לרביעייה, #key("Flight: weapons free") נותן אש חופשית לרביעייה, #key("Flight: low level / back to altitude") נותן גובה נמוך לרביעייה, או חזרה לגובה כשהיא טסה נמוך, ו-#key("Wingman: cover me") מורה לכידון 1-2 לחפות על המוביל.

המספרים קוראים גם מעצמם: "ג'וקר" ו"בינגו" על הדלק, "נעילה" או "נעילה מהקרקע" כשמכ"ם ננעל עליהם, "בהתחמקות" כשטיל טס אליהם, "שבירה שמאלה" או "שבירה ימינה" כשהם רואים טיל שנורה על המטוס השני בזוג, "יש מגע" כשהמכ"ם שלהם מוצא לראשונה מטוס אויב או מחזיק מטוס שה-AWACS דיווח עליו, ו"שלוש בהובלה" כשההובלה מתחלפת. מספר תחת נעילה או טיל פונה מהאיום, ומספר בסופה מפעיל גם את המשבש. מול טיל הוא משחרר גם מוץ, או נורים מול טיל מונחה חום: פעם אחת בשיגור ושוב בשניות האחרונות של הטיל. אחר כך הוא מצטרף חזרה. בלי פקודה הם נשארים במקום במבנה ונלחמים רק במטוס שתוקף אותם. בקרב הם קוראים "בקרב" כשהם נלחמים במטוס מיוזמתם (מטוס שתוקף אותם, מטוס שתוקף את המוביל בזמן חיפוי, או מטוס שהם צדים), "שיגור" על טיל, "תותח" על צרור, "המטרה נפלה" על הפלה ו"אין חימוש" כשלא נשאר במה לירות; נעילה בקרב מדווחת והתקיפה נמשכת. בתקיפת קרקע כל מספר קורא "נכנס" כשהוא מתחיל את היעף, "אלפא" כשהפצצות משתחררות ו"ביצעתי" כשהוא רחוק מהמטרה; אחר כך הוא מצטרף חזרה. פקודה חדשה מסיימת את התקיפה מיד והמספר מבצע אותה: הצטרפות, חזרה לבסיס, פיצול, חיפוי, חלוקת מטרות, אש חופשית, או תקיפת המטרה שלי שוב, שמתחילה את היעף מחדש. שינוי מבנה אינו מסיים אותה.
