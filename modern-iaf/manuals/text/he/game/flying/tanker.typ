#idx("מטוס תדלוק")#idx("תדלוק אווירי")#term("מטוס תדלוק") מעביר דלק למטוס באוויר דרך הבום שלו. הוא נמצא בטיסה רק כשיש לה מטוס תדלוק: במשימה שכוללת אחד, או בטיסת #scr("sec_fly_now") שהגרילה אחד (מחצית מהן; @mission-list-scramble).

=== היכן נמצא מטוס התדלוק <tanker-track>

מטוס התדלוק הוא KC-46A, שנקרא גדעון, או בואינג 707, שנקרא ראם. שמו הוא אות הקריאה שלו בקשר. הוא טס במסלול מרוצים עם פניות שמאלה בגובה 30,000 רגל ובמהירות 310 קשר מכשירית (480 קשר אמיתית): שתי צלעות באורך 50 מייל ימי, במרחק 20 מייל ימי זו מזו. הוא מופיע במכ"ם כמטוס ידידותי. יש למצוא אותו שם ולטוס אליו.

=== בקשת תדלוק <tanker-request>

#idx("בקשת תדלוק")
+ ללחוץ על #key("Call the tower").
  #then[העמוד הראשון של הרשימה מציג 4 מטוס תדלוק אחרי #term("מגדל"), המבנה ו-#term("AWACS"). כשאין בטיסה מטוס תדלוק, השורה לא מופיעה.]
+ ללחוץ על #keycap("4").
  #then[הרשימה מציגה קריאה אחת: 1 בקשת תדלוק.]
+ ללחוץ על #keycap("1").
  #then[הטייס קורא \u{2066}"Gideon, Kidon 1, request refuelling"\u{2069} (גדעון, כאן כידון 1, בקשת תדלוק). מטוס התדלוק עונה \u{2066}"Kidon 1, Gideon, cleared pre-contact"\u{2069} (#term("אישור") לעמדת טרום מגע), או \u{2066}"Kidon 1, stand by, observation left"\u{2069} (המתנה בעמדת תצפית משמאל) כשמטוס אחר על הבום.]
+ לפתוח את דלת התדלוק של המטוס במקש #key("Air refuelling door (open / close)").
+ לטוס לעמדת טרום המגע, מאחורי מטוס התדלוק ומתחתיו, ואז לעמדת המגע. הבומר עונה על כל שלב בקשר (בהמשך).
+ להתנתק בכל רגע במקש #key("A/R DISC: disconnect from the boom"). כשהמכלים מלאים, הבום משתחרר מעצמו.

הטיסה עצמה היא נוהל של המטוס, עם העמדות, הנורות והמגבלות: #other("f16i", "air-refuelling"), #other("f16d", "air-refuelling") וכן #other("f35i", "air-refuelling").

=== הקריאות של מטוס התדלוק <tanker-calls>

#idx("ניתוק חירום")#grid-table(
  (1fr, 1.3fr),
  ([מטוס התדלוק אומר], [משמעות, ומה לעשות]),
  [\u{2066}"cleared pre-contact"\u{2069} (אישור לעמדת טרום מגע)], [לטוס לעמדת טרום המגע, כ-15 מטר מאחורי עמדת המגע של הבום ומעט מתחתיה, ולהחזיק בה ביציבות כשהדלת פתוחה.],
  [\u{2066}"stand by, observation left"\u{2069} (המתנה בעמדת תצפית משמאל)], [מטוס אחר על הבום. להמתין ליד הכנף השמאלית של מטוס התדלוק. מטוס התדלוק מאשר טרום מגע כשהבום מתפנה.],
  [\u{2066}"cleared contact"\u{2069} (אישור למגע)], [להתקרב לאט לעמדת המגע. הבומר מכניס את הבום לפתח התדלוק.],
  [\u{2066}"contact"\u{2069} (מגע)], [הבום נעול והדלק זורם: 3,000 ליברות בדקה מגדעון, 2,000 ליברות בדקה מראם. יש להחזיק את העמדה.],
  [\u{2066}"disconnect"\u{2069} (ניתוק)], [הבום השתחרר: המטוס יצא מטווח הבום, או שהטייס התנתק. לחזור לעמדת טרום המגע; מטוס התדלוק מאשר מגע שוב.],
  [\u{2066}"breakaway, breakaway, breakaway"\u{2069} (ניתוק חירום)], [המטוס קרוב או גבוה מדי. לסגת מיד, 30 מטר או יותר. מטוס התדלוק מאשר שוב טרום מגע.],
  [\u{2066}"refuelling complete, cleared right wing"\u{2069} (התדלוק הושלם, אישור לכנף ימין)], [המכלים מלאים. לעבור לכנף הימנית של מטוס התדלוק ולסגור את הדלת. המטוס הבא מקבל אישור לבום.],
)

הקריאות מוצגות כשורות בראש המסך, כמו אלה של המגדל (@tower-subtitles).

=== תדלוק המספרים <tanker-wingmen>

#idx("תדלוק")כשיש בטיסה מטוס תדלוק, ברשימת הפקודות למספרים (@radio-flight) יש פקודת תדלוק, אל הרביעייה, אל זוג 3–4 או אל מספר אחד. כל מספר עונה באות הקריאה שלו וטס אל מטוס התדלוק. הוא ממתין ליד הכנף השמאלית של מטוס התדלוק ומתדלק בתורו. אחר כך הוא ממתין ליד הכנף הימנית. כשהאחרון מסיים, הם מצטרפים חזרה למוביל.
