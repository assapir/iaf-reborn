#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("מסך הטעינה")אחרי #scr("fly") המשחק מכין את הטיסה ומציג את מסך הטעינה. המסך מציג את שם המשימה, את הבסיס, מד התקדמות, ומתחת למד את השלב שמתבצע.

=== השלבים <loading-steps>

#screen("loading", [מסך הטעינה.], width: 60%)

השלבים באים בסדר הזה:

#grid-table(
  (auto, 1fr),
  ([שלב], [מה המשחק מכין]),
  [#scr("loading_cockpit")], [המשימה עצמה: מקום ההתחלה והמטוס.],
  [#scr("loading_scenery")], [החומרים של המבנים והעצים, הצלילים והקשר.],
  [#scr("loading_effects")], [פיצוצים, עשן והנזק למטוס.],
  [#scr("loading_flight_model")], [מודל הטיסה של המטוס.],
  [#scr("loading_jet")], [המודל החיצוני של המטוס.],
  [#scr("loading_jet_cockpit")], [תא הטייס וגוף הטייס.],
  [#scr("loading_jet_weapons")], [החימוש שעל המטוס, המבטים, התצוגות.],
  [#scr("loading_terrain")], [הקרקע שליד המטוס בפירוט מלא.],
  [#scr("loading_models")], [המודלים של שאר היחידות במשימה.],
  [#scr("loading_views")], [המבט החיצוני ושאר הנוף.],
)

המד מתקדם משלב לשלב. כשהוא מתמלא הטיסה מתחילה מיד: הישיבה היא בתא הטייס והשעון רץ.

=== הפעלה ראשונה איטית <loading-slow>

#idx("הפעלה ראשונה, איטית")הטעינה של הטיסה הראשונה אחרי התקנה או עדכון של המשחק ארוכה יותר. המשחק מכין אז את הגרפיקה למחשב, פעם אחת, חלק אחר חלק. המד עשוי לעמוד כמה שניות בתוך שלב. בזמן המתנה כזו המסך מוסיף מתחת לשלב את השורה הזו:

#scr-text("loading_slow")

ההפעלה הבאה מהירה: המשחק שומר את מה שהכין.

#note[המשחק עוקב אחרי הטעינה של עצמו. כששלב אינו מתקדם במשך 30 שניות, המשחק נעצר ופותח את #term("דף התקלה") (@crash-page), שמציין את השלב.]

הקרקע שליד הבסיס מתחילה להיטען כבר בזמן קריאת התדריך, ולכן טיסה שמתחילה אחרי כמה שניות בתדריך נטענת מהר יותר.
