#import "/modern-iaf/manuals/layout/manual.typ": *

הטיסה מתבצעת מתא טייס תלת-ממדי. אפשר לסובב בו את הראש, להטות אותו, להתקרב בזום ולצאת אל מחוץ למטוס. כל מקש בסעיף הזה ניתן לשינוי במסך #scr("keys_screen"), בקבוצה #scr("group_views") (@keys-joystick).

=== המבט מתא הטייס <views-cockpit>

#idx("מבט מתא הטייס")כל טיסה נפתחת בתא הטייס, כשהראש פונה ישר קדימה והמבט רחב ומכיל את כל הלוח הקדמי.

#idx("מבט בעכבר")*כדי להסתכל סביב בעכבר:*

+ להחזיק את הלחצן הימני של העכבר.
  #then[הסמן נעלם.]
+ להזיז את העכבר.
  #then[הראש מסתובב איתו. הוא מסתובב למטה עד הקונסולות הצדדיות.]
+ להרפות מהלחצן.
  #then[הראש נשאר במקומו, והסמן חוזר.]

כדי להסתכל שוב ישר קדימה יש ללחוץ לחיצה כפולה על הלחצן הימני של העכבר.

הלחצן השמאלי של העכבר מפעיל את הפקדים של תא הטייס (@clicking).

=== זום <views-zoom>

#idx("זום")הזום מצמצם את המבט, מהמבט הרחב ועד מבט קרוב שבו אפשר לקרוא מהכיסא את הטקסט הקטן של תצוגה.

#grid-table(
  (auto, 1fr),
  ([פקד], [מה הוא עושה]),
  [גלגלת העכבר, או גלילה במשטח מגע], [מתקרבת אל הסמן: מה שמתחת לסמן נשאר מתחתיו. מעל בורר הגלגלת מסובבת את הבורר (@clicking).],
  [#key("Zoom in (equals key)") או #key("Zoom in (numpad)")], [התקרבות בצעד אחד, סביב מרכז המבט.],
  [#key("Zoom out (minus key)") או #key("Zoom out (numpad)")], [התרחקות בצעד אחד.],
)

במבט מחוץ למטוס אותם מקשים מקרבים ומרחיקים את המצלמה.

=== מקשי המבט <views-look>

#idx("מקשי המבט")מקש מבט מפנה את הראש לכיוון קבוע כל עוד הוא לחוץ. כשמרפים, הראש חוזר.

#grid-table(
  (auto, auto, auto),
  ([שמאל], [מרכז], [ימין]),
  [#key("Look front-left (45 deg)")], [#key("Look up (30 deg)")], [#key("Look front-right (45 deg)")],
  [#key("Look left (90 deg)")], [#key("Look forward")], [#key("Look right (90 deg)")],
  [#key("Look back-left (135 deg)")], [#key("Look back")], [#key("Look back-right (135 deg)")],
)

הכובע של ג'ויסטיק מפנה את הראש לאותם שמונה כיוונים.

=== הטיה והזזה של הראש <views-lean>

#idx("הטיית הראש")מקש הטיה מזיז את הראש מעט כל עוד הוא לחוץ. כשמרפים, הראש חוזר בעדינות לכיסא. ההטיה מאפשרת לראות מתג שהסטיק, המצערת או שולי לוח מסתירים.

#grid-table(
  (auto, 1fr),
  ([מקש], [הראש זז]),
  [#key("Lean left"), #key("Lean right")], [6 ס"מ הצידה.],
  [#key("Lean forward")], [10 ס"מ קדימה. בלחיצה של כשנייה הוא ממשיך עד 30 ס"מ בסופה ובברק. באדיר הוא זז 2 ס"מ.],
  [#key("Lean back")], [10 ס"מ אחורה.],
  [#key("Raise the head")], [10 ס"מ למעלה.],
  [#key("Lower the head")], [15 ס"מ למטה.],
)

הראש נעצר לפני החופה והלוחות. גוף הטייס מוסתר כל עוד הראש רחוק מהכיסא.

=== מבט מלא על תצוגה <views-mfd>

#idx("מבט מלא על תצוגה")המקשים האלה מקרבים את העין אל תצוגה אחת, כך שהתצוגה והלחצנים שסביבה ממלאים את המסך.

#grid-table(
  (auto, 1fr),
  ([מקש], [מציג]),
  [#key("Full view of the left MFD")], [התצוגה השמאלית של הסופה ושל הברק. באדיר: התצוגה הרחבה האחת שלו.],
  [#key("Full view of the right MFD")], [התצוגה הימנית של הסופה ושל הברק. באדיר: התצוגה הרחבה האחת שלו.],
)

המטוס ממשיך לטוס, וכל מקש אחר פועל כמו מהכיסא. על לחצני התצוגה לוחצים בעכבר. כדי לחזור לכיסא יש ללחוץ שוב על אותו מקש או על #keycap("Esc"). המקש של התצוגה האחרת מעביר ישר אליה.

#screen("flight_mfd_view", [המבט המלא על התצוגה השמאלית של הסופה.], width: 70%)

=== גוף הטייס <views-body>

#idx("גוף הטייס, הסתרה")במבט למטה רואים את הרגליים, הזרועות והידיים של הטייס. הכפפה השמאלית שעל המצערת מכסה כמה מתגים בקונסולה השמאלית. לחיצה מגיעה גם למתג שמתחת לגוף. כדי לראות את המתג:

- להחזיק את #key("Hide pilot's body (hold)"): הגוף מוסתר כל עוד המקש לחוץ;
- ללחוץ על #key("Hide / show pilot's body"): הגוף מוסתר עד לחיצה נוספת על המקש.

הגוף מוצג שוב בתחילת כל טיסה. ב#term("שיעור") שמסמן בטבעת את המתג שיש להפעיל, המשחק מסתיר את הגוף מעצמו כל עוד הוא מכסה את המתג הזה (@notebook-ring).

=== מבטים מבחוץ <views-outside>

#idx("מבטים מבחוץ")מקש מבט מוציא את המצלמה מתא הטייס. מבט על דבר שאינו קיים (מטרת מכ"ם כשאין נעילה, חימוש כשאין חימוש באוויר) אינו עושה דבר.

#grid-table(
  (auto, 1fr),
  ([מקש], [המבט]),
  [#key("Cockpit / HUD-only view")], [ממבט חיצוני: חזרה לתא הטייס. בתא הטייס: מחליף בין תא הטייס לבין מבט על התע"ל לבדו, בלי תא הטייס סביבו. #key("Look forward") עושה אותו דבר.],
  [#key("Lock-on view")], [מתא הטייס, הראש עוקב אחרי מטרת המכ"ם.],
  [#key("Padlock nearest object")], [מתא הטייס, הראש עוקב אחרי העצם הקרוב ביותר למרכז המבט.],
  [#key("View of the radar target")], [מטרת המכ"ם, מבחוץ.],
  [#key("Threat view")], [המטוס והאיום הקרוב ביותר שה-RWR קולט. לחיצה שנייה: הראש עוקב אחרי האיום מתא הטייס.],
  [#key("Wingman view")], [המטוס ומספר 2. לחיצה שנייה: הראש עוקב אחרי מספר 2 מתא הטייס.],
  [#key("Player-to-target view")], [המטוס, ומטרת המכ"ם מעבר לו.],
  [#key("Target-to-player view")], [מטרת המכ"ם, והמטוס מעבר לה.],
  [#key("Fly-by view")], [המטוס מבחוץ, כשהוא חולף.],
  [#key("Chase view")], [המטוס מאחור.],
  [#key("View from the weapon")], [החימוש האחרון ששוחרר, כל עוד הוא באוויר.],
)

בכל מבט ממשיכים להטיס את המטוס. מבט מבחוץ מסיים מבט מלא על תצוגה.
