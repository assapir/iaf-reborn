=== הלשוניות <notebook-tabs>

#grid-table(
  (auto, 1fr),
  ([לשונית], [הדפים שלה]),
  [#scr("nb_startup")], [כרטיס הבד"ח של המטוס, חלק אחר חלק, מסומן תוך כדי העבודה (@notebook-checklist).],
  [#scr("nb_taxi")], [קריאות הקשר, ההסעה וההמראה כשלבים ממוספרים, והמסלול: המספר, הכיוון, האורך והגובה שלו.],
  [#scr("nb_radio")], [אות הקריאה, תדרי הבסיס, וכל קריאה עם התדר שבו משמיעים אותה ותשובת ה#term("מגדל") (@tower-radio).],
  [#scr("nb_landing")], [הנחיתה בחמש שורות: הקריאה, כן הנסע, הגישה הסופית, הנגיעה, כיבוי המנוע בעמדת החניה.],
  [#scr("nb_weapons")], [חימוש, אוויר-קרקע ואוויר-אוויר כשלבים קצרים, כל אחד עם המתג שלו, מקום המתג והמקש שלו.],
  [#scr("nb_refuel")], [רק כשיש בטיסה #term("מטוס תדלוק") (@tanker): בד"ח התדלוק האווירי של המטוס, לפני מגע, מגע ואחרי תדלוק, והשלבים מסומנים תוך כדי עבודה כמו בכרטיס הבד"ח. הנוהל נמצא במדריך של כל מטוס: #other("f16i", "air-refuelling"), #other("f16d", "air-refuelling") וכן #other("f35i", "air-refuelling").],
  [#scr("nb_emergency")], [לשונית אדומה: אש במנוע על הקרקע ובאוויר, התנעה באוויר אחרי שהמנוע כבה, תקלות הגנרטורים ובקרת הטיסה, והנטישה; בסופה ובברק גם #term("Hot start"), אש במנוע בהמראה ותקלות במערכות ההידראוליות. אלה הצעדים שתקלות במשימת אימון נענות להם.],
  [#scr("nb_data")], [המשימה, הבסיס והקוד שלו, שעת ההתחלה של הטיסה (בהזנקה, זו שנקבעה או שנבחרה באקראי) ובהזנקה גם התאריך שלה, הרוח, המטוס, המסלול והנקודה הראשונה בנתיב.],
)

הדפים מציינים כל מתג ואת מקומו בתא הטייס. רק הלשונית #scr("nb_weapons") מציינת מקשים. כל המקשים נמצאים במסך #scr("keys_screen") (@keys-joystick).

=== דפדוף <notebook-pages>

#idx("פנקס, דפדוף")הטקסט של לשונית מחולק לדפים. אפשר לדפדף בכל אחת מהדרכים האלה:

- ללחוץ על לשונית: הדף הראשון שלה נפתח.
- ללחוץ על ‹ או על › בתחתית הדף. המספר שביניהם, לדוגמה \u{2066}1 / 2\u{2069}, הוא הדף בתוך הלשונית.
- לסובב את גלגלת העכבר מעל הפנקס.
- ללחוץ על #key("Checklist notebook: previous page") או על #key("Checklist notebook: next page") כשהפנקס מורם.

אחרי הדף האחרון של לשונית נפתח הדף הראשון של הלשונית הבאה.

=== הלשונית בד"ח <notebook-checklist>

#idx("בד\"ח")הלשונית #scr("nb_startup") מציגה את כרטיס הבד"ח של המטוס: אותו כרטיס בכל משימה. הנהלים עצמם נמצאים במדריך של כל מטוס. ההתנעה: #other("f16i", "cold-start"), #other("f16d", "cold-start") וכן #other("f35i", "cold-start"). הכרטיס כולו עם שאר הנהלים הרגילים: #other("f16i", "normal"), #other("f16d", "normal") וכן #other("f35i", "normal").

כל פריט בכרטיס מציג את השורה שלו, איך לבצע אותו (הלחיצות, ההמתנות), ואת המתג שלו עם מקום המתג. הבד"ח עוקב אחרי תא הטייס:

#grid-table(
  (auto, 1fr),
  ([סימן], [משמעות]),
  [סימן ✓], [הפריט בוצע: המתג שלו עומד במצב שהכרטיס דורש. החזרת המתג מבטלת את הסימן.],
  [פס צהוב עם חץ], [#idx("הפס הצהוב")הפריט שיש לבצע עכשיו. הדף מתחלף מעצמו כדי שהפריט יישאר מוצג.],
  [טבעת קטנה (○)], [#idx("לקרוא ולאשר")פריט שקוראים ומאשרים. בשורה שלו כתוב: #scr-text("nb_ack"). המשחק אינו מסמן אותו ואינו הופך אותו לפריט שיש לבצע עכשיו.],
  [שורה אדומה מתחת לפריט], [המטוס סירב לשלב, והסיבה.],
)

פריט שבוצע לפני תורו מסומן. הפס הצהוב נשאר על הפריט המוקדם יותר עד שהוא מבוצע.

=== שורת הרמז <notebook-hints>

#idx("שורת הרמז")מתחת לפריט שבפס הצהוב הפנקס כותב, בשורה כחולה אחת, מה עוד חסר לפריט. השורה משתנה תוך כדי העבודה. דוגמאות:

- #scr-text("nb_hint_batt")
- #scr-text("nb_hint_throttle_off")
- #scr-text("nb_hint_ins_off")
- #scr-text("nb_hint_ins_nav")
- #scr-text("nb_hint_selftest")

שורות רמז אחרות סופרות: ה-#term("RPM") של המנוע בזמן שהמתנע מסובב אותו, המתגים בקבוצה שעדיין כבויים, השניות שנותרו ליישור ה-#term("INS").
