#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("AWACS")ה-#term("AWACS") הוא הבקר המוטס. הוא צופה בשמיים במכ"ם שלו ומוסר בקשר היכן נמצאים מטוסים אחרים. הוא קורא לטייס מיוזמתו ועונה לבקשות.

=== הקריאות על מטוסים <awacs-calls>

#idx("AWACS, קריאות")מהדקה הראשונה של הטיסה ה-AWACS מדווח על מטוס שנמצא בטווח של 35 מיילים ימיים. כל עוד יש שם מטוס, הוא מדווח שוב כל 12 שניות. במטווח החימוש (@lesson-range) הקריאות עוסקות במל"טי המטווח. בשיעורי ההתנעה וההמראה אין מטוסים אחרים, ולכן ה-AWACS שותק בהם.

כך נשמעת קריאה:

\u{2066}"Kidon 1, bearing 090, 15 miles, target, heading 270, free to engage"\u{2069}

יש לקרוא אותה חלק אחר חלק:

#grid-table(
  (auto, 1fr),
  ([חלק], [משמעות]),
  [כידון 1], [אות הקריאה של המטוס: הקריאה מיועדת אליו.],
  [bearing 090], [הכיוון מהמטוס אל המטוס האחר, כמעלות מצפן. 090 הוא מזרח. פנייה לכיוון הזה מפנה את האף אליו.],
  [\u{2066}15 miles\u{2069}], [המרחק אליו, במיילים ימיים.],
  [target], [מה הוא: מטוס שיש לתקוף.],
  [heading 270], [הכיוון שבו המטוס האחר טס. 270 הוא מערב: יחד עם הכיוון שלמעלה, הוא מתקרב.],
  [free to engage], [רשאי לתקוף.],
)

=== קריאת המשימה <awacs-task>

#idx("קריאת משימה")בטיסת #scr("sec_fly_now") (@mission-list-scramble) ה-AWACS מוסר גם את המשימה. הקריאה הראשונה מגיעה כמה שניות אחרי שהמטוס באוויר. היא חוזרת כל דקה כל עוד המטרה קיימת, ומוסרת היכן החלק הקרוב ביותר של המטרה.

\u{2066}"Kidon 1, attack the convoy, bearing 040, 25 miles, free to engage"\u{2069}

#grid-table(
  (auto, 1fr),
  ([חלק], [משמעות]),
  [כידון 1], [אות הקריאה של המטוס: הקריאה מיועדת אליו.],
  [attack the convoy], [המשימה; בעברית: תקיפת השיירה. המשימות האחרות: יירוט מטוסי אויב (זוג מיג 29), יירוט מל"טים, ותקיפת סוללת הטילים (ה-S-300).],
  [bearing 040], [הכיוון מהמטוס אל המטרה, כמעלות מצפן.],
  [\u{2066}25 miles\u{2069}], [המרחק אליה, במיילים ימיים.],
  [free to engage], [רשאי לתקוף.],
)

=== שימוש בקריאה <awacs-use>

+ להפנות את המטוס לכיוון שנמסר.
+ לקבוע למכ"ם טווח גדול מהמרחק שבקריאה.
+ לחפש את המטוס במכ"ם.

הפעלת המכ"ם ונעילה על מטרה מתוארות במדריך של כל מטוס: #other("f16i", "radar-aa"), #other("f16d", "radar-aa") וכן #other("f35i", "radar-aa").

הקריאות נשמעות בקול של ה-AWACS, בשפת המשחק, ומוצגות כשורות בראש המסך, כמו אלה של ה#term("מגדל") (@tower-subtitles). כיוון מכשירי הקשר של המטוס מתואר במדריכים: #other("f16i", "radios"), #other("f16d", "radios") וכן #other("f35i", "radios"). קריאות ה-AWACS מגיעות בכל מצב של מכשירי הקשר.

=== בקשות מה-AWACS <awacs-requests>

#idx("AWACS, בקשות")#idx("תפריט הקשר")אפשר לשאול את ה-AWACS היכן המטוסים האחרים, מהו מטוס מסוים ולאן לטוס.

+ ללחוץ על #key("Call the tower").
  #then[הרשימה מציגה 1 מגדל, 2 המבנה ו-3 AWACS.]
+ ללחוץ על 3.
  #then[מופיעות הבקשות מה-AWACS. בקשה שאי אפשר לבקש כעת מעומעמת, והסיבה לצידה. #keycap("0") חוזר אחורה.]
+ ללחוץ על המספר של בקשה.
  #then[הטייס קורא ל-AWACS ("עיטם, כידון 1, תמונה אווירית"), וה-AWACS עונה.]

#grid-table(
  (auto, 1fr),
  ([בקשה], [התשובה של ה-AWACS]),
  [תמונה אווירית], [כמה מבנים של מטוסים הוא רואה, ואז שלושת הקרובים ביותר, הקרוב ראשון: "כידון 1, שני מבנים. מבנה אזימוט 040, 30 מייל, גובה 20 אלף, מתקרב, עוין". "אין מגעים" כשהוא אינו רואה אף מטוס.],
  [המגע הקרוב], [המבנה הקרוב ביותר, באותן מילים.],
  [זיהוי], [מהו המטוס שהמכ"ם נעול עליו: "עוין", "לא מזוהה" או "ידידותי"; "אין מגעים" כשה-AWACS אינו רואה אותו. מעומעם כשאין נעילה.],
  [הכוונה למטרה], [הכיוון והמרחק אל המטרה: "כידון 1, הכוונה 040, 25 מייל, מטרה". בטיסת #scr("sec_fly_now") המטרה היא של המשימה; אחרת המבנה העוין הקרוב ביותר.],
  [הכוונה לבסיס], [הכיוון והמרחק אל בסיס האם: "... בסיס האם".],
  [הכוונה למטוס התדלוק], [הכיוון והמרחק אל מטוס התדלוק הקרוב. עדיין אין מטוס תדלוק באוויר, ולכן השורה מעומעמת.],
)

יש לקרוא מבנה חלק אחר חלק:

#grid-table(
  (auto, 1fr),
  ([חלק], [משמעות]),
  [מבנה], [מטוס אחד, או כמה מטוסים בטווח של 3 מיילים ימיים זה מזה.],
  [אזימוט 040, 30 מייל], [הכיוון אליו כמעלות מצפן, והמרחק אליו במיילים ימיים, כמו בקריאה על מטוס.],
  [גובה 20 אלף], [הגובה שלו, באלפי רגל.],
  [מתקרב], [לאן הוא פונה: "מתקרב" אל המטוס, "באלכסון" חלקית אליו, "בניצב" לרוחב הקו, "מתרחק" ממנו.],
  [עוין], [מטוס אויב. "לא מזוהה" הוא מטוס שעדיין לא זוהה.],
)

גם המספרים שומעים את התשובות: מספר שהמכ"ם שלו מחזיק מבנה שה-AWACS מסר קורא "יש מגע" (@radio-flight).

=== העיטם <awacs-eitam>

#idx("עיטם")בטיסת #scr("sec_fly_now") ה-AWACS הוא העיטם, הגאלפסטרים G550 של חיל האוויר עם המכ"ם שלו. הוא טס במסלול סגלגל ארוך בגובה 41,000 רגל, מאחורי הדרך אל הקרב ולצידה, כך שהוא לעולם אינו בנתיב הטיסה, והמכ"ם שלו מכסה את הקרב. בטיסות האחרות אין ל-AWACS מטוס בשמיים.

האויב יכול לתקוף את העיטם. כשמטוסי אויב מתקרבים אליו, הוא פונה מהם במהירות מרבית וקורא לעזרה:

"כידון 1, איום, מבנה אזימוט 040, 30 מייל, גובה 25 אלף, עיטם בנסיגה, יירוט"

המבנה נמסר ביחס למטוס, כמו בתמונה אווירית: יש לטוס אליו, או לשלוח את המספרים (@radio-flight). הקריאה חוזרת כל דקה כל עוד האויב קרוב לעיטם. כשהאיום חולף, העיטם חוזר למסלול סגלגל מעט מאחור.

אם העיטם מופל, ה-AWACS אינו פעיל עד סוף הטיסה: אין עוד קריאות, כל הבקשות מעומעמות ("העיטם אבד: אין AWACS"), וקשר הנתונים של המטוס אינו מציג עוד את המטוסים שלו.
