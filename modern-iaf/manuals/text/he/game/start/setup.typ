#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("התקנה")#idx("אשף ההתקנה")ההתקנה בונה את נתוני המשחק: הקרקע, הבסיסים, היחידות והחימוש, נתוני הטיסה של המטוסים, הצלילים והקולות, ומשימות האימון. #term("אשף ההתקנה") עושה זאת עמוד אחרי עמוד. מריצים אותו פעם אחת לפני ההפעלה הראשונה, ושוב בכל פעם שרוצים להוסיף חלק או לבנות חלק מחדש.

=== לפני שמתחילים <setup-before>

- להתקין את התוכנות שב@requirements-programs.
- לפנות בדיסק את המקום שמפורט ב@requirements-disk.
- לחבר את המחשב לאינטרנט.

=== הפעלת האשף <setup-start>

+ לפתוח מסוף בתיקיית המשחק.
+ להריץ `./modern-iaf-setup` במסוף. ב-Windows יש להריץ את `.\modern-iaf-setup.ps1` במקומו.
  #then[הסקריפט בונה את תוכנת המשחק כשהיא חדשה או השתנתה, ואז חלון האשף נפתח בעמוד הראשון שלו, #stp("page_welcome").]

גם סקריפט ההפעלה של המשחק פותח את האשף, כל עוד נתוני המשחק חסרים (@start-game).

=== עמודי האשף <setup-pages>

#screen("setup_welcome", [העמוד הראשון של ההתקנה: מה היא מורידה ובונה, ומה היא דורשת. כאן אין בדיסק די מקום פנוי לכל אריחי תצלומי הלוויין, ולכן העמוד מציג מספרים קטנים יותר, והשאר נקרא ברשת בזמן הבנייה.], width: 70%)

לאשף ארבעה עמודים. #stp("next") עובר לעמוד הבא ו#stp("back") לעמוד הקודם.

#grid-table(
  (auto, 1fr),
  ([עמוד], [מה יש בו]),
  [#stp("page_welcome")], [#stp("language"): עברית או אנגלית, לאשף ולמשחק. מה ההתקנה מורידה ובונה. #stp("download"), #stp("disk") ו#stp("time"). #stp("needs"): GDAL ו-curl, כל אחד #stp("found") או #stp("missing"), והמקום הפנוי בדיסק. הלחצן #stp("credits") פותח את רשימת כל המקורות עם הרישיונות שלהם; #stp("close") או #keycap("Esc") סוגרים אותה. #stp("next") ממתין עד ש-GDAL, curl והמקום בדיסק קיימים.],
  [#stp("page_imagery")], [בחירת תמונת הקרקע (@setup-imagery).],
  [#stp("page_install")], [שורה לכל #term("שלב התקנה"), עם מד ההתקדמות והמצב שלו (@setup-steps). הלחצן #stp("install") מתחיל את ההרצה.],
  [#stp("page_done")], [האם המשחק מותקן. תיבת הסימון שמוסיפה את המשחק לתפריט של מערכת ההפעלה (@setup-menu). #stp("start_game") פותח את המסך הראשון של המשחק. #stp("close") סוגר את האשף.],
)

=== בחירת תצלומי הלוויין <setup-imagery>

#screen("setup_imagery", [עמוד בחירת תצלומי הלוויין.], width: 70%)

#idx("תצלומי לוויין")#idx("צילום האוויר של המרכז למיפוי ישראל")תצלומי הלוויין הם תמונת הקרקע שמונחת על פני השטח. העמוד #stp("page_imagery") מציע שתי אפשרויות, כל אחת עם השטח שהיא תופסת בדיסק והזמן שלה.

#grid-table(
  (1fr, 1.6fr),
  ([אפשרות], [מה היא נותנת]),
  [#stp("s2")], [תצלומי לוויין ב-8 מ' לפיקסל מעל ישראל וב-32 מ' מחוצה לה. כ-\u{200E}469 MB של קרקע בדיסק.],
  [#stp("survey")], [אותו הדבר, ובנוסף צילום האוויר של המרכז למיפוי ישראל ב-2 מ' לפיקסל מעל ישראל. כ-\u{200E}3.57 GB של קרקע בדיסק, ובנייה של כשעה ו-42 דקות.],
)

האפשרות השנייה דורשת את קובצי הגיליונות של המרכז למיפוי ישראל משנת 2015 (79 קובצי ZIP מהאתר data.gov.il, \u{200E}17 GB) בתיקייה שהעמוד מציין. האשף אינו מוריד אותם. בלעדיהם העמוד מודיע על כך ונשאר על #stp("s2").

=== השלבים <setup-steps>

#idx("שלבי ההתקנה")העמוד #stp("page_install") מציג שמונה שלבים. שישה הם חובה: בלעדיהם המשחק אינו יכול לעלות או להטיס משימה. שניים הם רשות, והם מסומנים כברירת מחדל.

#grid-table(
  (1.1fr, 1.5fr, 1.5fr),
  ([שלב], [מה הוא בונה], [מה הוא מוריד, הגודל והזמן]),
  [#stp("step_sim-terrain")], [הקרקע: הגבהים ותצלומי הלוויין שלה. חובה.], [גבהי Copernicus GLO-30 (627 MB) ותצלומי Sentinel-2 (11.4 GB), פעם אחת. כ-17 דקות בפעם הראשונה, כולל ההורדה; כשעה ו-42 דקות עם צילום האוויר של המרכז למיפוי ישראל. כשכל הקבצים כבר בדיסק, השורה מציגה מתחת לשם השלב #stp("dl_none").],
  [#stp("step_sim-db")], [המטוסים, יחידות הקרקע והחימוש. חובה.], [אינו מוריד דבר. שניות.],
  [#stp("step_sim-fm")], [מודלי הטיסה של המטוסים. חובה.], [אינו מוריד דבר. שניות.],
  [#stp("step_sim-own")], [הצלילים, קולות הקשר וטבלת המקשים. חובה.], [אינו מוריד דבר. שניות.],
  [#stp("step_sim-airbases")], [הבסיסים על הקרקע, עם קו החוף ומקווי המים. חובה. ממתין לשלב הקרקע.], [קובצי OpenStreetMap (450 MB), פעם אחת. שניות אחרי ההורדה.],
  [#stp("step_sim-missions")], [משימות האימון בבסיסים. חובה. ממתין לבסיסים, וליחידות ולחימוש.], [אינו מוריד דבר. שניות.],
  [#stp("step_sim-scenery")], [המבנים, העצים, הכבישים ואורות הערים בלילה. בלעדיו טסים מעל תצלום הקרקע בלבד, וההגדרה #scr("scenery") מעומעמת (@settings-graphics). ממתין לבסיסים.], [נתוני המבנים. השורה מציגה את גודל ההורדה ואת השטח בדיסק מתחת לשם השלב.],
  [#stp("step_sim-textures")], [מרקמים מקרוב לקרקע, לדגמים ולעצים. בלעדיו המשחק מצייר אותם במשטחים חלקים.], [חומרי ambientCG, כ-\u{200E}310 MB. השורה מציגה את הגדלים מתחת לשם השלב.],
)

שלבים שאינם ממתינים זה לזה רצים בו בזמן. שלב שנכשל עוצר את השלבים שממתינים לו.

=== ביצוע ההתקנה <setup-install>

#screen("setup_install", [עמוד ההתקנה: שורה לכל שלב.], width: 70%)

+ בעמוד #stp("page_install"), לבדוק את המצב של כל שורה.
  #then[שלב שצריך לרוץ מציג #stp("state_will_run"). שלב שהנתונים שלו מעודכנים מציג #stp("state_up_to_date").]
+ לבטל את הסימון של שלב רשות שרוצים להשמיט (@setup-leave-out).
+ לבחור #stp("install").
  #then[השלבים רצים. שורת המצב מציגה #stp-text("installing") כל שורה שרצה מציגה את המד שלה ואת הזמן שנותר לשלב; שורה מתחת לשורת המצב מציגה את הזמן שנותר לכל השלבים, או את מספר השלב כשהזמן עדיין לא ידוע.]
+ להמתין לשלב האחרון.
  #then[שורת המצב מציינת כמה שלבים רצו וכמה היו מעודכנים. האשף פותח את העמוד #stp("page_done") עם #stp-text("set_up")]
+ לבחור #stp("start_game").
  #then[המשחק נפתח (@start-game).]

=== תפריט היישומים <setup-menu>

#idx("תפריט היישומים")#idx("תפריט התחל")העמוד #stp("page_done") מוסיף את המשחק לתפריט של מערכת ההפעלה, עם הסמל של המשחק, כך שאפשר להפעיל אותו משם כמו כל תוכנה אחרת. תיבת הסימון שלו מסומנת מראש, ושמה תלוי במערכת:

#grid-table(
  (auto, auto, 1fr),
  ([מערכת], [תיבת הסימון], [היכן המשחק מופיע]),
  [Linux], [#stp("menu_linux")], [תפריט היישומים. כששולחן העבודה בעברית, הפריטים מוצגים בשם העברי של המשחק.],
  [macOS], [#stp("menu_mac")], [תיקיית היישומים של חשבון המשתמש: Launchpad ו-Spotlight מוצאים שם את המשחק. ה-Dock מציג את הסמל שלו מרגע ההפעלה.],
  [Windows], [#stp("menu_windows")], [תפריט התחל, בתיקייה "Modern IAF".],
)

נוספים שני פריטים: "Modern IAF" מפעיל את המשחק (@start-game-start), ו-"Modern IAF — Setup" פותח את האשף הזה. ב-Linux עם שולחן עבודה בעברית שמותיהם "הזרוע הארוכה" ו"הזרוע הארוכה — התקנה".

+ כדי להסיר אותם, לבטל את הסימון בתיבה.
  #then[הפריטים מוסרים מיד. האשף זוכר את הבחירה.]
+ כדי להוסיף אותם שוב, לסמן את התיבה.

כשהשינוי לא מצליח, שורה מתחת לתיבה מסבירה מדוע.

=== מצבי השלב <setup-states>

#screen("setup_install_skipped", [עמוד ההתקנה אחרי הרצה: שלב שהושמט מציג את הסיבה ואת הלחצן לניסיון חוזר.], width: 70%)

#grid-table(
  (auto, 1fr),
  ([מצב], [מה פירושו]),
  [#stp("state_checking")], [האשף בודק אם השלב צריך לרוץ.],
  [#stp("state_will_run")], [השלב ירוץ כשבוחרים #stp("install").],
  [#stp("state_up_to_date")], [נתוני השלב מעודכנים. ההרצה מדלגת עליו.],
  [#stp("state_waiting")], [השלב ממתין לתורו או לשלב שהוא זקוק לו.],
  [#stp("state_running")], [השלב פועל. המד שלו מציג את ההתקדמות.],
  [#stp("state_done")], [השלב רץ והנתונים שלו נבנו.],
  [#stp("state_skipped")], [השלב לא יכול היה לרוץ או להסתיים. הסיבה מופיעה מתחת לשורה, עם #stp("retry") (@setup-faults).],
  [#stp("state_failed")], [השלב נעצר בגלל שגיאה. הפרטים ביומן (@setup-log).],
  [#stp("state_blocked")], [שלב שהשלב הזה ממתין לו נכשל, ולכן הוא לא רץ.],
  [#stp("state_cancelled")], [ההרצה בוטלה בזמן שהשלב פעל.],
  [#stp("state_excluded")], [שלב רשות שהסימון שלו בוטל.],
)

=== ביטול והמשך <setup-cancel>

#idx("התקנה, ביטול")בזמן הרצה הלחצן #stp("back") מציג #stp("cancel").

+ לבחור #stp("cancel").
  #then[שורת המצב מציגה #stp-text("cancelling") השלבים שרצים נעצרים בפריט הבא שלהם.]
+ כדי להמשיך, לבחור שוב #stp("install").
  #then[השלבים שהסתיימו נשמרים. שלב הקרקע שומר את החלקים שסיים ואת הקבצים שהוריד, וממשיך משם.]

אפשר גם לסגור את האשף ולהפעיל אותו שוב מאוחר יותר: ההרצה ממשיכה מהמקום שבו נעצרה.

=== הרצה חוזרת של שלב <setup-again>

#idx("התקנה, הרצה חוזרת")ההרצה מדלגת על שלב מעודכן. שלושה פקדים מריצים שלב בכל זאת.

#grid-table(
  (auto, 1fr),
  ([פקד], [מה הוא עושה]),
  [#stp("row_redo")], [תיבת סימון בשורת השלב. ההרצה הבאה בונה את השלב אף שהוא מעודכן. סימון שלה אחרי הרצה שהסתיימה מחזיר את הלחצן #stp("install").],
  [#stp("retry")], [מתחת לשלב שהושמט או נכשל. מריץ את ההתקנה שוב; השלב רץ כי לא הסתיים.],
  [#stp("redo")], [מריץ את כל השלבים, גם המעודכנים. לקרקע זו בנייה מלאה מחדש.],
)

אף אחד מהשלושה אינו מוריד קובץ שכבר נמצא בדיסק.

=== השמטת שלב והסרת הנתונים שלו <setup-leave-out>

#screen("setup_install_remove", [ההתקנה שואלת לפני שהיא מסירה את הנתונים של שלב שהושמט.], width: 70%)

#idx("התקנה, שלבי רשות")השורה של כל שלב רשות מתחילה בתיבת סימון. ההסבר שלה: #stp-text("include").

+ לבטל את סימון השלב לפני ההרצה.
  #then[השורה מציגה #stp("state_excluded"). השלב אינו מורד ואינו נבנה. האשף זוכר את הבחירה.]

כשהשלב כבר בנוי, ביטול הסימון פותח את החלון #stp("remove_title") עם המקום בדיסק שההסרה מפנה.

#caution[#stp("remove") מוחק את הנתונים שהשלב בנה. כשתיבת הסימון של ההורדות באותו חלון מסומנת, נמחקים גם הקבצים שהשלב הוריד, וסימון השלב מחדש מוריד אותם שוב. כדי להשאיר הכול בדיסק יש לבחור #stp("keep").]

+ לבחור #stp("remove") כדי למחוק את נתוני השלב, או #stp("keep") כדי להשאיר אותם.
  #then[אחרי #stp("remove") שורת המצב מציינת כמה מקום התפנה.]

כדי להוסיף את השלב מאוחר יותר, יש לסמן אותו שוב ולבחור #stp("install").

=== היומן <setup-log>

#idx("התקנה, יומן")#stp("show_log") בעמוד #stp("page_install") פותח את יומן ההרצה בחלון; #stp("hide_log") סוגר אותו. כל הרצה גם כותבת את היומן המלא לקובץ משלה בתיקיית המשחק: `assets/logs/modern-iaf-setup-<date>-<time>.log`.
