#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("מדריכים")למשחק ארבעה מדריכים. המדריך הזה, מדריך המשחק, מתאר את המשחק שסביב המטוסים. לכל מטוס יש מדריך טיסה משלו, שמתאר אותו במלואו: המערכות, הנהלים, המגבלות והחימוש שלו.

#grid-table(
  (auto, 1fr),
  ([מדריך], [מה הוא מתאר]),
  [הזרוע הארוכה, מדריך המשחק], [ההתקנה, התפריטים, ההגדרות, טיסת משימה, השיעורים והאופן שבו הם נבחנים, הבסיסים, ה#term("מגדל") והקשר.],
  [#other-manual("f16i")], [ה-F-16I #scr-text("sufa").],
  [#other-manual("f16d")], [ה-F-16D #scr-text("barak").],
  [#other-manual("f35i")], [ה-F-35I #scr-text("adir").],
)

כשהמדריך הזה מפנה לנוהל של מטוס, הוא מקשר לסעיף המתאים במדריך של כל מטוס. קישור פותח את הקובץ של המדריך האחר, ולכן יש לשמור את ארבעת קובצי ה-PDF בתיקייה אחת.

=== מסך המדריכים <manuals-screen>

#idx("מסך המדריכים")המשחק פותח את המדריכים בעצמו.

+ ב#term("דת\"ק"), לבחור #scr("manuals") בתחתית המסך.
  #then[המסך #scr("manuals") מציג את שלושת מדריכי הטיסה ואת מדריך המשחק. השורה שלו: #scr-text("manuals_sub")]
+ לבחור מדריך.
  #then[המדריך נפתח במציג ה-PDF של המערכת.]
+ לבחור #scr("back") או ללחוץ על #keycap("Esc") כדי לחזור לדת"ק.

מדריך שהקובץ שלו חסר מעומעם. מדריכי הטיסה כתובים באנגלית בשתי שפות המשחק (@language).
