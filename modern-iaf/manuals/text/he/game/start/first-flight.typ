#import "/modern-iaf/manuals/layout/manual.typ": *

הדרך מה#term("דת\"ק") אל תא הטייס היא ארבעה צעדים. ההתנעה של המטוס עצמו מפורטת במדריך שלו (@manuals).

+ בדת"ק, לבחור מטוס תחת #scr("aircraft") (@hangar).
+ לבחור #scr("fly"). המסך #scr("missions") נפתח (@mission-list).
+ לבחור #scr("sec_fly_now"), ולבחור את המבנה, את אופן ההתחלה ואת השעה (@mission-list-scramble).
+ לבחור #scr("fly"). מסך הטעינה פועל (@loading) ויושבים בתא הטייס.

הבד"ח ב#term("פנקס") מדריך את הטיסה (@notebook). החלק #scr("sec_training") באותו מסך מכיל את ההסבה של המטוס, שלב אחרי שלב (@mission-list-training); הטיסות של התרגולים יגיעו בגרסה מאוחרת יותר.
