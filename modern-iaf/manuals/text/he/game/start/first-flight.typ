#import "/modern-iaf/manuals/layout/manual.typ": *

הסעיף הזה מוביל מה#term("דת״ק") אל ה#term("תחקיר") של #term("שיעור") האימון הראשון, #scr("kind_startup"): #scr-text("desc_startup") המטוס עומד כבוי בבסיס שלו ונשאר על הקרקע, ולכן אין מה להפסיד בניסיון.

=== לפני שמתחילים <first-flight-before>

- ההתקנה הסתיימה (@setup) ויש פרופיל (@start-game-first).
- לקרוא פעם אחת את נוהל ההתנעה של המטוס. הוא נמצא במדריך של המטוס:
  - לסופה: #other("f16i", "cold-start")
  - לברק: #other("f16d", "cold-start")
  - לאדיר: #other("f35i", "cold-start")

=== מהדת״ק אל תא הטייס <first-flight-go>

+ בדת״ק, לבחור מטוס תחת #scr("aircraft").
  #then[המטוס עומד במרכז המסך, והכרטיס שלו מציג את הטייסת ואת הבסיס שלו (@hangar).]
+ לבחור #scr("fly").
  #then[המסך #scr("missions") נפתח (@mission-list).]
+ לבחור #scr("sec_training").
  #then[שיעורי המטוס מוצגים לפי הסדר. הראשון מסומן #scr("next_up").]
+ לבחור את השיעור הראשון, #scr("kind_startup").
  #then[התדריך שלו נפתח: מפת הבסיס וכרטיס המשימה (@briefing).]
+ לקרוא את #scr("objectives") ואת #scr("learn") בתדריך.
+ לבחור #scr("fly").
  #then[מסך הטעינה מציג את שלבי הטעינה (@loading). אחר כך יושבים בתא הטייס, והמנוע כבוי.]

=== בתא הטייס <first-flight-cockpit>

ה#term("פנקס") מורם מלפנים, פתוח בלשונית #scr("nb_startup"): הבד״ח של המטוס, שורה לכל שלב. #key("Checklist notebook") מוריד אותו ומחזיר אותו (@notebook).

+ לבצע את השלב הפתוח הראשון בבד״ח. ללחוץ בסמן על המתג שהשורה מציינת (@clicking).
  #then[הפנקס מסמן את השלב כבוצע ומדגיש את השלב הבא.]
+ להמשיך, שלב אחרי שלב, עד סוף הבד״ח.
  #then[המנוע פועל בסרק והאוויוניקה פועלת. הטיסה מושהית מתחת ללוח #scr("fl_complete").]
+ לבחור #scr("debrief").
  #then[התחקיר נפתח: התוצאה, היעדים וההערות (@debrief).]

כששלב ממתין למטוס (מהירות המנוע, היישור), הפנקס מציין למה הוא ממתין. הסיבה לכל שלב מוסברת במדריך של המטוס. מה נחשב הצלחה ומה כישלון בשיעור מפורט ב@lesson-startup וב@scoring.

כדי לעצור מוקדם, יש ללחוץ על #keycap("Esc") ולבחור #scr("end_flight") (@time-pause).

=== אחרי התחקיר <first-flight-after>

- #scr("next_mission") פותח את התדריך של השיעור הבא, #scr("kind_takeoff"). בו כל תנועה על הקרקע ממתינה ל#term("אישור") מה#term("מגדל"); איך לבקש אותו מוסבר ב@tower.
- #scr("fly_again") פותח שוב את אותו תדריך.
- #scr("back_missions") פותח את רשימת השיעורים. השיעורים לפי הסדר מתוארים ב@lessons.
