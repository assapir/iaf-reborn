#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("פרופיל")פרופיל הוא הזהות של מי שטס במשחק: שם, כינוי, תמונה ויומן של כל הטיסות. המשחק יכול להחזיק כמה פרופילים; אחד מהם הוא הפרופיל שבשימוש, וכל טיסה נרשמת ביומן שלו. פרופיל שומר גם תצורות חימוש משלו לכל מטוס (@loadout).

=== מסך הפרופיל <pilots-screen>

בחירה בפרופיל שבסרגל העליון של ה#term("דת\"ק") פותחת את המסך #scr("pilot").

#screen("pilot", [המסך #scr("pilot"): הפרופיל ו#scr("logbook").])

#grid-table(
  (auto, 1fr),
  ([חלק], [מה הוא עושה]),
  [#scr("pilot_name")], [השם המלא. פרופיל זקוק לשם כדי להישמר.],
  [#scr("pilot_nickname")], [השם הקצר שמוצג בסרגל העליון של כל מסך. בלי כינוי המסכים מציגים את השם.],
  [התמונה], [מסגרת בצורת תמונת פספורט. בלי תמונה היא מציגה את ראשי התיבות של השם.],
  [#scr("choose_picture")], [פותח את חלון הקבצים של המערכת לבחירת קובץ תמונה. לחיצה על המסגרת עושה אותו דבר. התמונה נחתכת כך שתמלא את המסגרת.],
  [#scr("logbook")], [לכל מטוס שהוטס, מהמטוס עם זמן הטיסה הרב ביותר: זמן הטיסה, מספר הטיסות, כמה הצליחו וכמה נכשלו, ואותם נתונים לכל משימה שהוטסה בו. פרופיל בלי טיסות מציג #scr("no_flights")],
  [#scr("pilot_log")], [פותח את #term("יומן טיסות", shown: "יומן הטיסות") (@pilots-log).],
  [#scr("reset_log")], [מוחק את הטיסות של הפרופיל (@pilots-reset). מעומעם כל עוד אין לפרופיל טיסות.],
  [#scr("delete_profile")], [מוחק את הפרופיל (@pilots-delete).],
  [#scr("other_pilots")], [פותח את רשימת הפרופילים (@pilots-change).],
  [#scr("back")], [חוזר לדת"ק. #keycap("Esc") עושה אותו דבר.],
  [#scr("save")], [שומר את השם, הכינוי והתמונה, ופותח את הדת"ק.],
)

=== שינוי השם, הכינוי או התמונה <pilots-edit>

#idx("פרופיל, שם ותמונה")
+ להקליד את הטקסט החדש בשדה #scr("pilot_name") או #scr("pilot_nickname"), או לבחור #scr("choose_picture") ולבחור קובץ.
  #then[המסך מציג את השינוי. עדיין לא נשמר דבר.]
+ לבחור #scr("save").
  #then[השינוי נשמר והדת"ק נפתח.]

כשיוצאים מהמסך עם שינוי שלא נשמר, המשחק שואל #scr("discard_title") #scr("discard") מבטל את השינוי; #scr("keep_editing") חוזר למסך.

=== יצירת הפרופיל הראשון <pilots-first>

בהפעלה הראשונה המשחק פותח את המסך #scr("first_pilot") לפני הדת"ק: מסך הפרופיל עם #scr("save") בלבד. השלבים מתוארים ב@start-game-first.

=== פרופיל חדש והחלפת פרופיל <pilots-change>

#idx("פרופיל, חדש")#idx("פרופיל, החלפה")
+ במסך #scr("pilot"), לבחור #scr("other_pilots").
  #then[המסך #scr("pilots") מציג כל פרופיל עם התמונה או ראשי התיבות שלו, הכינוי והשם. הפרופיל שבשימוש מסומן #scr("current").]
+ כדי לטוס בפרופיל אחר, לבחור אותו.
  #then[הפרופיל הזה בשימוש והדת"ק נפתח.]
+ כדי ליצור פרופיל, לבחור #scr("new_pilot"), למלא את מסך הפרופיל הריק ולבחור #scr("save").
  #then[הפרופיל החדש נשמר, נמצא בשימוש, והדת"ק נפתח.]

#screen("pilots", [המסך #scr("pilots").], width: 70%)

=== איפוס היומן <pilots-reset>

#idx("יומן טיסות, איפוס")
#caution[איפוס היומן מוחק את כל הטיסות ואת כל #term("תחקיר") של הפרופיל. #scr-text("reset_sure_text") השם, הכינוי והתמונה נשארים. כדי לשמור הקלטה של טיסה, יש לייצא אותה קודם מהתחקיר שלה (@debrief).]

+ במסך #scr("pilot"), לבחור #scr("reset_log").
  #then[המשחק שואל #scr("reset_title"), ו#scr("cancel") נבחר מראש.]
+ לבחור #scr("reset").
  #then[המשחק שואל פעם שנייה: #scr("reset_sure_title")]
+ לבחור #scr("reset").
  #then[היומן של הפרופיל ריק.]

#scr("cancel") או #keycap("Esc") בכל אחת מהשאלות משאירים את היומן כפי שהוא.

#screen("pilot_reset", [הראשונה משתי השאלות שלפני איפוס היומן.], width: 70%)

=== מחיקת הפרופיל <pilots-delete>

#idx("פרופיל, מחיקה")
#caution[מחיקת הפרופיל מוחקת אותו כולו: השם, הכינוי, התמונה, כל הטיסות והתחקירים, ותצורות החימוש של הפרופיל. #scr-text("delete_sure_text")]

+ במסך #scr("pilot"), לבחור #scr("delete_profile").
  #then[המשחק שואל #scr("delete_title"), ו#scr("cancel") נבחר מראש.]
+ לבחור #scr("delete").
  #then[המשחק שואל פעם שנייה: #scr("delete_sure_title")]
+ לבחור #scr("delete").
  #then[הפרופיל נמחק. רשימת הפרופילים נפתחת; כשלא נשאר אף פרופיל, נפתח המסך #scr("first_pilot").]

=== יומן הטיסות <pilots-log>

#idx("יומן טיסות")#term("יומן טיסות", shown: "יומן הטיסות") מציג את כל הטיסות של הפרופיל שבשימוש, מהחדשה ביותר. פותחים אותו בלחצן #scr("pilot_log") שבמסך #scr("pilot"), או באותו לחצן בתחקיר.

#screen("log", [#scr("pilot_log").])

#grid-table(
  (auto, 1fr),
  ([עמודה], [מה היא מציגה]),
  [#scr("date")], [היום והשעה של הטיסה.],
  [#scr("mission")], [המשימה שהוטסה.],
  [#scr("plane_flown")], [המטוס שהוטס.],
  [#scr("result")], [#scr("pass") או #scr("fail") (@scoring).],
)

מעל הרשימה שני מסננים:

- *המטוס.* #scr("all_jets"), או אחד מהמטוסים שהוטסו בפרופיל.
- *המשימה.* #scr("all_missions"), או אחת מהמשימות שהוטסו. כשנבחר מטוס, הרשימה מציעה רק את המשימות שלו.

בחירה בשורה פותחת את התחקיר של הטיסה (@debrief). #scr("back") או #keycap("Esc") חוזרים למסך #scr("pilot").

=== העברת הנתונים למחשב אחר <pilots-export>

#idx("ייצוא")למסך הפרופיל וליומן הטיסות אין ייצוא משלהם. שני מסכים אחרים כותבים קבצים שאפשר לשמור או להעביר:

- #scr("export_flight") שבתחקיר כותב את הקלטת הטיסה לקובץ (@debrief).
- #scr("export_settings") ו#scr("import_settings") שבהגדרות כותבים וקוראים את ההגדרות (@settings-file). הפרופילים נשארים במחשב שבו נוצרו.
