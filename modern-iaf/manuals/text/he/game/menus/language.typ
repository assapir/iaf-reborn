#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("שפה")#idx("עברית")#idx("אנגלית")למשחק שתי שפות, אנגלית (#scr("language_en")) ו#scr("language_he"). #term("אשף ההתקנה") שואל על השפה בעמוד הראשון שלו, והמשחק עולה בה.

=== החלפת השפה <language-switch>

+ ב#term("דת\"ק"), לבחור #scr("preferences").
+ לבחור את החלק #scr("language").
+ בשורה #scr("language"), לבחור #scr("language_en") או #scr("language_he").
  #then[כל המסכים משתנים מיד, גם המסך הנוכחי.]

אותה שורה נמצאת בהגדרות שתפריט ההשהיה פותח, ולכן אפשר להחליף שפה בזמן טיסה.

#screen("prefs_language", [החלק #scr("language").], width: 80%)

=== מה משתנה <language-changes>

#grid-table(
  (auto, 1fr),
  ([דבר], [בעברית]),
  [המסכים], [כל מסכי התפריטים, תפריט ההשהיה, מסך הטעינה, ה#term("תחקיר") ואשף ההתקנה הם בעברית ובתמונת ראי: מה שעומד בצד שמאל באנגלית עומד בצד ימין.],
  [כתוביות הקשר], [השורות של ה#term("מגדל") ושל הקולות האחרים נכתבות בעברית מעל הטיסה.],
  [ה#term("פנקס")], [דפי הפנקס והבד"ח שבו הם בעברית.],
  [שמות מקשים, מספרים ושעות], [נקראים משמאל לימין, כמו באנגלית.],
  [שורות הרישיון במסך #scr("credits")], [נשארות באנגלית.],
)

=== מה נשאר באנגלית <language-english>

- *הקולות.* המגדל, הטייסים האחרים וקול האזהרה של המטוס מדברים אנגלית בשתי השפות. בעברית הכתוביות נושאות את הטקסט העברי.
- *תא הטייס.* הכיתובים של המתגים והתצוגות הם של המטוסים האמיתיים, באנגלית.
- *המדריכים.* מדריכי הטיסה של המטוסים הם קובצי PDF באנגלית (@manuals).
