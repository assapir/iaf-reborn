#idx("מטוסים")#idx("טייסות")המשחק מטיס שלושה מטוסים. כל אחד שייך לטייסת וטס מבסיס האם שלה, ולכן בחירת מטוס היא גם בחירת הבסיס שממנו המשימות שלו מתחילות. הבסיסים מתוארים ב@airbases.

=== המטוסים <hangar-jets>

#grid-table(
  (auto, auto, auto, 1fr),
  ([מטוס], [טייסת], [בסיס], [המדריך שלו]),
  [F-16I #scr("sufa")#idx("סופה")], [טייסת 201, ״האחת״], [#scr("base_ramon")], [#other("f16i", "description")],
  [F-16D #scr("barak")#idx("ברק")], [טייסת 101, ״הקרב הראשונה״], [#scr("base_ramat_david")], [#other("f16d", "description")],
  [F-35I #scr("adir")#idx("אדיר")], [טייסת 116, ״אריות הדרום״], [#scr("base_nevatim")], [#other("f35i", "description")],
)

ברשימה עומדים עוד שני מטוסים, מעומעמים. הם עדיין אינם בסימולטור: אי אפשר לבחור בהם ואין להם משימות.

#grid-table(
  (auto, auto, 1fr),
  ([מטוס], [טייסת], [בסיס]),
  [F-15I #scr("raam")], [טייסת 69], [#scr("base_hatzerim")],
  [F-15C #scr("baz")], [טייסת 133], [#scr("base_tel_nof")],
)

=== בחירת מטוס <hangar-choose>

#idx("מטוס, בחירה")
+ ב#term("דת״ק"), להביט תחת #scr("aircraft").
  #then[כל שורה מציגה את השם המלא של מטוס, את מספר הטייסת שלו ואת הבסיס שלו.]
+ לבחור שורה של מטוס, או לעבור אליה במקשי החצים וללחוץ על #keycap("Enter").
  #then[המטוס עומד במרכז המסך ונושא את #term("תצורת חימוש", shown: "תצורת החימוש") שלו. הכרטיס מציג את #scr("squadron_l"), את #scr("base_l") ואת #scr("tail_number") שלו, ותחת #scr("training") כמה מהשיעורים שלו עברו ואת הטיסה האחרונה בו.]
+ לבחור #scr("fly").
  #then[המסך #scr("missions") נפתח למטוס הזה (@mission-list).]

המשחק זוכר את המטוס. ההפעלה הבאה פותחת את הדת״ק איתו.

=== מה הבחירה משנה <hangar-effect>

- *המשימות.* לכל מטוס משימות משלו, מהבסיס שלו. המסך #scr("missions") מציג רק את המשימות של המטוס שנבחר, וסופר רק אותן בהתקדמות.
- *תצורת החימוש.* החימוש שמתחת למטוס בדת״ק הוא התצורה האחרונה שנקבעה לו, או תצורת המשימות כשלא נקבעה תצורה (@loadout).
- *תא הטייס והנהלים.* לכל מטוס תא טייס משלו ובד״ח משלו. הם מתוארים במדריך הטיסה של המטוס (@manuals).

ל-F-16I ול-F-16D רוב תא הטייס והנהלים משותפים; ה-F-35I שונה לגמרי.
