#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("מקשים")#idx("ג'ויסטיק")המקלדת מטיסה את המטוס כולו: לכל פקודה יש מקש, וג'ויסטיק הוא תוספת. שני מסכים קובעים אותם, #scr("keys_screen") ו#scr("joystick_screen"). שניהם נפתחים מהמסך #scr("preferences"), חלק #scr("devices"), בלחצן #scr("change") שבשורות שלהם (@settings-devices). #scr("back") או #keycap("Esc") בכל אחד מהם חוזרים לחלק #scr("devices").

שינוי חל מיד. בזמן טיסה הוא חל כשסוגרים את ההגדרות.

כל הפקודות עם המקשים שלהן מפורטות בכרטיס המקשים, @keys.

=== מסך המקשים <keys-joystick-keys>

#idx("מסך המקשים")המסך #scr("keys_screen") מציג כל פקודה עם המקש שלה, בחמש קבוצות: #scr("group_flight"), #scr("group_weapons"), #scr("group_sensors"), #scr("group_views") ו#scr("group_sim"). הלשוניות שבצד גוללות את הרשימה אל קבוצה. השורה שמתחת לכותרת: #scr-text("keys_sub")

#screen("devices_keys", [המסך #scr("keys_screen").])

=== שינוי מקש <keys-joystick-change>

#idx("מקשים, שינוי")
+ לבחור את שורת הפקודה.
  #then[במקום המקש השורה מציגה #scr("press_key")]
+ ללחוץ על המקש החדש, לבדו או יחד עם מקש צירוף אחד.
  #then[השורה מציגה את המקש החדש, ולחצן #scr("default").]

#keycap("Esc") במקום מקש משאיר את הפקודה כפי שהייתה.

#screen("devices_keys_wait", [שורה שממתינה למקש החדש שלה.], width: 80%)

=== מקש שכבר שייך לפקודה אחרת <keys-joystick-conflict>

#idx("מקשים, התנגשות")כשהמקש שנלחץ כבר מפעיל פקודה אחרת, נפתחת שורה מתחת לשורת הפקודה. היא מציינת את המקש ואת הפקודה האחרת, ומציעה שלוש אפשרויות.

#grid-table(
  (auto, 1fr),
  ([אפשרות], [מה היא עושה]),
  [#scr("swap")], [שתי הפקודות מחליפות מקשים: הפקודה הזו מקבלת את המקש, והאחרת מקבלת את המקש הקודם של הפקודה הזו.],
  [#scr("take")], [הפקודה הזו מקבלת את המקש. הפקודה האחרת נשארת בלי מקש.],
  [#scr("cancel")], [שתי הפקודות נשארות כפי שהיו.],
)

#screen("devices_keys_conflict", [השורה שמתחת לשורת הפקודה, עם שלוש האפשרויות שלה.], width: 80%)

=== חזרה למקשי ברירת המחדל <keys-joystick-default>

#idx("מקשים, ברירות מחדל")
- #scr("default") בשורה ששונתה מחזיר את הפקודה למקש ברירת המחדל שלה.
- #scr("reset_all") בסרגל התחתון מחזיר את כל המקשים.

#caution[#scr("reset_all") מבטל את כל המקשים ששונו, מיד ובלי לשאול. כדי להחזיר פקודה אחת יש להשתמש בלחצן #scr("default") שבשורה שלה.]

=== מפת המקשים למחשב נייד <keys-joystick-laptop>

#idx("מפת המקשים למחשב נייד")מקשי ברירת המחדל משתמשים במקלדת המספרים להגה הכיוון ולהסתכלות סביב, ובמקשים Page Up, Page Down, Home ו-End לכמה פקודות נוספות. במחשב Mac נייד אין אף אחד מהמקשים האלה, ולכן ב-macOS המשחק מתחיל מ#term("מפת המקשים למחשב נייד"): אותה טבלה, כשהפקודות שלמטה נמצאות על מקשים אחרים. גם Mac עם מקלדת מלאה מקבל אותה; שם #scr("default") ו#scr("reset_all") מחזירים למפת המקשים למחשב נייד. ב-Linux וב-Windows המשחק מתחיל ממקשי ברירת המחדל.

במדריך הזה, מקש עם שתי שורות מציג את מקש ברירת המחדל למעלה ואת מקש ה-macOS מתחתיו.

