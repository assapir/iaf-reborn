לשני מקשי ההתקרבות וההתרחקות של מקלדת המספרים אין מקש במפת המקשים למחשב נייד. הזוג האחר פועל בכל מקלדת: #key("Zoom out (minus key)") ו#key("Zoom in (equals key)").

ב-macOS המסך #scr("keys_screen") כותב את מקשי הצירוף בשמות שלהם ב-Mac. עוד על מקלדת של Mac ב@mac-keys.

#screen("devices_keys_mac", [המסך #scr("keys_screen") עם מפת המקשים למחשב נייד.], width: 80%)

=== מסך הג'ויסטיק <keys-joystick-joystick>

#idx("מסך הג'ויסטיק")במסך #scr("joystick_screen") שלושה חלקים: #scr("joy_devices"), #scr("joy_axes") ו#scr("joy_buttons"). כשאין ג'ויסטיק מחובר, השורה שלו בהגדרות מעומעמת ומציגה #scr("joy_none") היא חוזרת לפעול כשמחברים ג'ויסטיק.

#screen("devices_joystick", [המסך #scr("joystick_screen"): ההתקן והצירים שלו.])

#grid-table(
  (auto, 1fr),
  ([חלק], [מה יש בו]),
  [#scr("joy_devices")], [כל התקן מחובר, בשמו. ההתקן שמטיס את המטוס מסומן #scr("joy_in_use"): הלחצנים והכובע שלו פועלים. זה ההתקן שעליו התפקיד #scr("role_roll"), ואם אין כזה, הראשון.],
  [#scr("joy_axes")], [שורה לכל ציר של כל התקן, עד שישה להתקן: מד חי, התפקיד של הציר, #scr("invert") ו#scr("dead_zone"). כשמחובר יותר מהתקן אחד, הצירים של כל התקן מופיעים תחת שמו, של הג'ויסטיק קודם.],
  [#scr("joy_buttons")], [רשימת הפקודות, כמו במסך #scr("keys_screen"), עם לחצן הג'ויסטיק של כל אחת.],
  [#scr("reset_all")], [מחזיר את הלחצנים ואת הצירים לברירות המחדל שלהם.],
)

=== קביעת ציר <keys-joystick-axes>

#idx("ג'ויסטיק, צירים")
+ להזיז את הסטיק, את הידית או את הדוושות.
  #then[המד של הציר שמזיזים עוקב אחריו.]
+ באותה שורה, לבחור את תפקיד הציר מהרשימה.
  #then[הציר מקבל את התפקיד. ציר שהתפקיד היה שלו קודם מציג #scr("role_none").]
+ להזיז שוב את הפקד ולהביט במד.
  #then[המד מתמלא כפי שהמטוס מגיב: ידית מצערת עד הסוף קדימה היא מד מלא.]
+ כשהמד נע בכיוון ההפוך, לסמן את #scr("invert").
+ לקבוע את #scr("dead_zone") כך שהמד אינו זז כשהסטיק במנוחה.

#grid-table(
  (auto, 1fr),
  ([תפקיד], [מה הציר עושה]),
  [#scr("role_roll")], [מגלגל את המטוס: הסטיק שמאלה וימינה.],
  [#scr("role_pitch")], [מרים ומוריד את האף: הסטיק אחורה וקדימה.],
  [#scr("role_throttle")], [קובע את עוצמת המנוע. אין לו מרכז ואין לו #term("שטח מת").],
  [#scr("role_rudder")], [מזיז את הגה הכיוון: דוושות, או סיבוב של הסטיק.],
  [#scr("role_trim")], [מקזז את הגלגול: מתג נדנדה על המצערת.],
  [#scr("role_none")], [הציר אינו עושה דבר.],
)

תפקיד נמצא על ציר אחד בלבד. כשלתפקיד אין ציר, המקשים שלו ממשיכים לפעול: כשהתפקיד #scr("role_roll") אינו על אף ציר, מקשי הגלגול מגלגלים את המטוס והסטיק שולט בעלרוד.

#term("שטח מת", shown: "השטח המת") נע בין 0 ל-50%. ברירת המחדל שלו 25% בסטיק ובהגה הכיוון, 5% בהם כשההגדרה #scr("stick_response") על #scr("soft"), ו-10% במתג הנדנדה של הקיזוז.

#idx("ג'ויסטיק, התקן שני")מצערת נפרדת או דוושות פועלות לצד הג'ויסטיק. אחרי שמחברים אותן, הצירים שלהן מופיעים תחת שמן: נותנים לאחד מהם תפקיד כמו למעלה, והתפקיד נקרא מההתקן הזה. התקן שמחברים במהלך טיסה פועל מיד. כשמנתקים התקן במהלך טיסה, צירי הסטיק והגה הכיוון שלו חוזרים למרכז, והמקשים שלהם פועלים שוב.

ציר נקרא רק כשההגדרה שלו קובעת זאת: #scr("flight_controls") על #scr("joystick") לסטיק, #scr("rudder") על #scr("pedals"), #scr("throttle") על #scr("lever") (@settings-devices).

=== לחצני הג'ויסטיק והכובע <keys-joystick-buttons>

#idx("ג'ויסטיק, לחצנים")#idx("ג'ויסטיק, כובע")
+ תחת #scr("joy_buttons"), לבחור את שורת הפקודה.
  #then[השורה מציגה #scr("press_button")]
+ ללחוץ על הלחצן בג'ויסטיק.
  #then[השורה מציגה את מספר הלחצן.]

לחצן שכבר שייך לפקודה אחרת פותח את אותן שלוש אפשרויות כמו מקש (@keys-joystick-conflict), והלחצן #scr("default") פועל כמו במסך #scr("keys_screen").

#scr-text("joy_buttons_note")

#screen("devices_joystick_buttons", [החלק #scr("joy_buttons").], width: 80%)

=== ג'ויסטיקים שהמשחק מכיר <keys-joystick-maps>

#idx("Thrustmaster T.Flight Hotas X")ג'ויסטיק שהמשחק מכיר בשמו מקבל #term("מיפוי התקן"): הצירים והלחצנים שלו נקבעים כשמחברים אותו. למשחק מיפוי התקן אחד.

#grid-table(
  (auto, 1fr),
  ([Thrustmaster T.Flight Hotas X], []),
  [צירים], [ציר 1 #scr-text("role_roll"), ציר 2 #scr-text("role_pitch"), ציר 3 #scr-text("role_throttle"), ציר 4 #scr-text("role_rudder") (סיבוב הסטיק), ציר 5 #scr-text("role_trim") (מתג הנדנדה, כשהג'ויסטיק במצב 5 צירים).],
  [לחצנים], [1 הדק התותח, 2 שחרור החימוש הנבחר, 3 המטרה הבאה, 4 נורים, 5 מוץ, 6 מצב ראשי, 7 מצב מכ"ם, 8 שחרור הנעילה על המטרה, 9 כן נסע, 10 מדפים, 11 בלמי גלגלים, 12 טייס אוטומטי.],
  [כובע], [המבט, בשמונה כיוונים.],
)

כל ג'ויסטיק אחר מתחיל כשצירים 1 עד 5 הם גלגול, עלרוד, מצערת, הגה כיוון וקיזוז גלגול. קובעים אותו במסך #scr("joystick_screen").

=== נקודת המבער <keys-joystick-detent>

#idx("נקודת המבער")לידיות מצערת רבות יש נקישה סמוך לסוף המהלך שלהן. ההגדרה #scr("throttle_detent") מודיעה למשחק היכן הנקישה, כך שהידית בנקישה נותנת עוצמה מלאה בלי מבער, והמהלך שאחריה מדליק את המבער. #term("נקודת המבער") דורשת ג'ויסטיק מחובר שהתפקיד #scr("role_throttle") נמצא על אחד מהצירים שלו.

+ לפתוח את המסך #scr("preferences"), חלק #scr("devices").
+ להזיז את ידית המצערת אל הנקישה שלה ולהשאיר אותה שם.
+ בשורה #scr("throttle_detent"), לבחור #scr("set_at_lever").
  #then[האפשרות מציגה את מקום הידית באחוזים.]

#scr("off") מחלק שוב את מהלך הידית באופן שווה, והמבער בסופו.

#screen("devices_prefs_detent", [השורה #scr("throttle_detent") אחרי הקביעה.], width: 80%)

=== הגדרות הבקרה <keys-joystick-settings>

חמש ההגדרות שקובעות מה מטיס את המטוס הן שורות בחלק #scr("devices") שבהגדרות: #scr("flight_controls"), #scr("rudder"), #scr("throttle"), #scr("throttle_detent") ו#scr("stick_response"). כל אחת מתוארת, עם הערכים וברירת המחדל שלה, ב@settings-devices.
