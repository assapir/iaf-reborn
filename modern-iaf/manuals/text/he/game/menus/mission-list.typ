#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("מסך המשימות")המסך #scr("missions") נפתח מהלחצן #scr("fly") שב#term("דת\"ק"). יש בו המשימות של המטוס שנבחר, לפי חלקים.

#screen("missions", [המסך #scr("missions"): כרטיס לכל חלק.])

=== החלקים <mission-list-sections>

כל חלק הוא כרטיס עם המספר שלו, הכותרת שלו, ובתחתיתו ההתקדמות בו: כמה מהמשימות שלו עברו, ומד.

#grid-table(
  (auto, 1fr),
  ([חלק], [מה יש בו]),
  [#scr("sec_training")#idx("אימונים")], [שלושת השיעורים של כל מטוס מבסיס האם שלו: #scr("kind_startup"), #scr("kind_takeoff") ומטווח החימוש (@lessons).],
  [#scr("sec_campaign")#idx("מערכה")], [יגיע בגרסה מאוחרת יותר. הכרטיס מעומעם ומסומן #scr("coming_later").],
  [#scr("sec_single")#idx("משימות בודדות")], [יגיע בגרסה מאוחרת יותר. הכרטיס מעומעם ומסומן #scr("coming_later").],
  [#scr("sec_fly_now")#idx("הזנקה")], [קרב קצר מול אויב שנבחר באקראי; את המשימה מוסר ה-#term("AWACS") (@mission-list-scramble). בכרטיס אין מד התקדמות.],
)

כרטיס מעומעם אינו מקבל לחיצה ואינו מקבל מיקוד.

=== רשימת החלק <mission-list-rows>

בחירה בחלק #scr("sec_training") פותחת את הרשימה שלו: המשימות של המטוס שנבחר לפי הסדר, ממוספרות מ-1.

#screen("section", [הרשימה של #scr("sec_training"), עם הלוח של המשימה שבמיקוד.])

#grid-table(
  (auto, 1fr),
  ([חלק בשורה], [מה הוא מציג]),
  [המספר והכותרת], [מקום המשימה בחלק והשם שלה.],
  [השורה שמתחת לכותרת], [הבסיס ומה המשימה מאמנת.],
  [התוצאה האחרונה], [#scr("pass") עם הזמן הטוב ביותר, #scr("fail"), או #scr("not_flown").],
  [#scr("next_up")], [הסימון על המשימה שיש לטוס עכשיו: זו שאחרי המשימה האחרונה שהוטסה. אחרי המשימה האחרונה בחלק, זו הראשונה שעוד לא עברה. כשכל המשימות עברו, אף שורה אינה מסומנת.],
)

הלוח שליד הרשימה מוסיף פרטים על המשימה שבמיקוד או שמתחת לסמן: המספר והכותרת שלה, #scr("learn"), הבסיס שלה, #scr("time_allowed"), #scr("last_result") עם התאריך, ו#scr("best_time").

=== התחלת משימה <mission-list-fly>

#idx("משימה, התחלה")
+ במסך #scr("missions"), לבחור חלק.
  #then[רשימת החלק נפתחת. המיקוד על המשימה שמסומנת #scr("next_up").]
+ לבחור שורה של משימה, או ללחוץ על #keycap("Enter") כשהמיקוד עליה.
  #then[התדריך של המשימה נפתח (@briefing).]
+ לבחור #scr("fly") בתדריך.
  #then[המשימה נטענת (@loading).]

#scr("back") או #keycap("Esc") חוזרים מסך אחד אחורה: מהרשימה למסך #scr("missions"), וממנו לדת"ק.

=== הזנקה <mission-list-scramble>

#idx("הזנקה")בחירה ב#scr("sec_fly_now") פותחת מסך שבו מכינים קרב קצר: בלי משימה ובלי ניקוד. המבנה יוצא מבסיס האם של המטוס שנבחר, והמסך מציין את הבסיס הזה. הקרב מתנהל סביב בסיס אחר בטווח מבסיס האם, והאויב שם נבחר באקראי בכל טיסה. עד כמה האויב טס ויורה היטב, וכמה אויב יש, נקבע ב#scr("enemy_skill") במסך הפרופיל (@pilots); המסך מציין אותה מתחת לשורות.

#screen("free", [המסך #scr("sec_fly_now").])

#grid-table(
  (auto, 1fr),
  ([שורה], [מה בוחרים]),
  [#scr("fc_flight")], [#scr("fc_flight_1"), #scr("fc_flight_2") או #scr("fc_flight_4"). המחשב מטיס את המספרים.],
  [#scr("fc_start")], [#scr("fc_start_air"): המבנה מתחיל 60 ק"מ (32 מיילים ימיים) מהקרב, בגובה 6,000 מ', בכיוון אליו. #scr("fc_start_runway"): המבנה עומד בזוגות על המסלול בבסיס האם, המנועים פועלים; ממריאים, והמספרים ממריאים בזוגות מאחור. #scr("fc_start_ground"): קודם מתניעים, מסיעים וממריאים (@tower).],
  [#scr("fc_when")], [קודם התאריך, אחריו השעה. התאריך: היום שבו הטיסה טסה, בשנה הזו. החצים שליד היום מזיזים יום, החצים שליד החודש חודש. התאריך קובע מתי השמש זורחת ושוקעת: ב-0630 עוד חושך ב-21 בדצמבר ויום מלא ב-21 ביוני. הוא קובע גם את הירח: את המופע שלו ואת מקומו בשמיים. לילה של ירח מלא אפור עמום; לילה בלי ירח כמעט שחור, ורק האורות על הקרקע והכוכבים נראים. מזג האוויר וטמפרטורת האוויר זהים כל השנה. #scr("fc_random") (דלוק כשהמסך נפתח): היום נבחר כשטסים, בכל יום בשנה; העמוד #scr("nb_data") במחברת מציג אותו. השעה: השעה ביום שבה הטיסה מתחילה, שעון ישראל, בארבע ספרות של 24 שעות: 0630 היא שש וחצי בבוקר, 2200 היא עשר בלילה. החצים שליד השעות מזיזים שעה, החצים שליד הדקות חמש דקות; השעון ממשיך מעבר לחצות. השמש, השמיים והאורות לפי השעה: בלילה טסים לפי המכשירים ושמי הלילה. #scr("fc_random") (דלוק כשהמסך נפתח): השעה נבחרת כשטסים, בכל שעה ביום; העמוד #scr("nb_data") במחברת מציג אותה (@notebook-tabs).],
)

#scr("fc_flight") ו#scr("fc_start") נשמרים לביקור הבא; התאריך והשעה מתחילים שוב ב#scr("fc_random") בכל פתיחה של המסך (ומתחתיו היום ו-0800). #scr("tab_arming") פותח את מסך החימוש של המטוס (@loadout). #scr("fly") טוען את הטיסה (@loading).

אחרי שהמטוס באוויר, ה-#term("AWACS") מוסר בקשר את המשימה: מה ליירט או לתקוף, והיכן: הכיוון והמרחק מהמטוס (@awacs-task). המשימה היא אחת מאלה:

- יירוט זוג מיג 29 בסיור בין בסיס הקרב לבסיס האם;
- יירוט ארבעה מל"טים שטסים מעל בסיס הקרב לכיוון בסיס האם;
- תקיפת שיירה של שני טנקי T-72 ושתי משאיות בכבישים ליד בסיס הקרב;
- תקיפת סוללת S-300 מעבר לבסיס הקרב.

שם עשויים להמתין גם איומים אחרים: עוד זוגות מיג 29 באוויר או בדת"קים של אותו בסיס, מערך S-300 שמזניק אותם, הגנה אווירית לטווח קצר, המל"טים או השיירה. #scr("enemy_skill") גבוהה יותר מביאה יותר מהם. במחצית מהטיסות יש גם #term("מטוס תדלוק") במסלול בין הבסיס לקרב; אפשר לבקש ממנו דלק בקשר (@tanker). הטיסה אינה מנוקדת; מסיימים אותה מתפריט ההשהיה.

האויב נלחם כמו צוותים אמיתיים. מטוסי הקרב שלו נכנסים לקרב אוויר מקרוב: מסתובבים אל הזנב, מאטים לצד המטוס כדי שיעבור אותם, מתרחקים לצבור מהירות וחוזרים, ויורים טיל מונחה חום על מטוס שהטייס רואה, בלי צורך במכ"ם. מערך S-300 משתף את מה שהמכ"מים ומטוסי הקרב שלו רואים: סוללה שהמכ"מים שלה כבויים יכולה לנעול ולירות לפי התמונה הזאת, ולכן ה-RWR עשוי לא לקלוט חיפוש לפני הנעילה. ב#scr("enemy_skill") גבוהה יותר מטוסי הקרב מבצעים יותר מהתמרונים האלה, הסוללות מפעילות את מכ"ם החיפוש רק לפרקים קצרים, ועוברות למקום חדש מהר יותר אחרי שירו.

=== המסך בלי משימות <mission-list-nodata>

כשנתוני המשחק לא נבנו, כל החלקים מעומעמים, והערה מתחת לכותרת מודיעה על כך ומציינת פקודת התקנה. מה לעשות מוסבר ב@after-update-no-missions.
