#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("תדריך")התדריך הוא המסך שבין המסך #scr("missions") (@mission-list) לבין הטיסה. הוא נפתח כשבוחרים משימה. מפה של הבסיס ממלאת את המסך. כרטיס המשימה מונח עליה בצד אחד, והטקסט של המשימה בצד השני.

#screen("briefing_2012", [התדריך של המראה מרמון בסופה.])

=== כרטיס המשימה <briefing-card>

בכרטיס, מלמעלה:

- *הכותרת והשורה שמתחתיה.* שם המשימה, מה היא במשפט אחד, ואחריהם המטוס, הטייסת והבסיס שלו.
- *הנתונים.* ארבעה נתונים של הטיסה:

#grid-table(
  (auto, 1fr),
  ([נתון], [מה הוא אומר]),
  [#scr("runway")], [קצה המסלול שממנו ממריאים והכיוון שלו, לדוגמה 25R ו-246°. זה הכיוון שמצפן המטוס מציג על המסלול הזה. משימה שמסתיימת לפני ההמראה אינה מציגה מסלול.],
  [#scr("time")], [השעה בתחילת הטיסה, בארבע ספרות: 0800 היא שמונה בבוקר.],
  [#scr("wind")], [הכיוון שממנו הרוח נושבת, במעלות, והמהירות שלה בקשר. 000° ו-0 קשר פירושם רוח שקטה.],
  [#scr("time_allowed")], [מספר הדקות שיש מתחילת הטיסה כדי להשיג את היעדים.],
)

- *#scr("objectives").* מה המשחק בודק, כל יעד ליד תיבה ריקה. אותן בדיקות קובעות את התוצאה ב#term("תחקיר") (@debrief). השורה האחרונה, #scr("obj_safe"), מייצגת את הדברים שמכשילים כל משימה מיד.
- *#scr("tab_arming").* החימוש שעל המטוס בקיצור, #scr("takeoff_weight") ו#scr("edit"). המשקל מוצג בצבע האזהרה כשהוא מעל המשקל המרבי של המטוס. #term("תצורת חימוש") שהמטוס אינו יכול להשתמש בה בטיסה מציגה כאן את הסיבה בשורה אחת (@loadout-rules).
- *הלחצנים.* #scr("back"), #scr("tab_arming") ו#scr("fly").

#idx("מבנים (תדריך)")משימה עם יותר ממבנה אחד מציגה גם את #scr("flights"): לשונית לכל מבנה, המבנה שבו טסים ראשון, מסומן #scr("your_flight"). בחירה בלשונית מציגה את המטוסים, התפקיד והחימוש של אותו מבנה, ומביאה את הנתיב שלו לתצוגה במפה.

=== הטקסט של המשימה <briefing-text>

בכרטיס הטקסט שני חלקים:

- *#scr("learn").* שתיים או שלוש שורות: מה ה#term("תרגול") מלמד. משימה מסוג אחר מציגה כאן את #scr("purpose").
- *#scr("how").* פסקאות ממוספרות: מה לעשות, לפי הסדר, מהקריאה הראשונה ל#term("מגדל") ועד היעד האחרון. המקשים שבטקסט הם המקשים שנקבעו במסך #scr("keys_screen") (@keys-joystick). המסלול, הכיוון וה#term("זמן מוקצב", shown: "זמן המוקצב") הם הנתונים של המשימה עצמה. תרגול התנעה מציג מתחת לכל פסקה תמונה של המתג שלה, עם טבעת סביב המתג.

הגלילה בטקסט נעשית בגלגלת העכבר. במקלדת, יש להעביר את המיקוד לטקסט ולהשתמש במקשי החצים או במקשים #keycap("Page Up") ו#keycap("Page Down").

#screen("startup_f16i", [התדריך של התנעה.])

=== התדריך של תרגול <briefing-lesson>

#idx("תדריך תרגול")#term("תרגול") במסלול האימונים מתודרך לפי סדר פקודת מבצע צבאית. המפה, סיכום החימוש והלחצנים כמו בכל תדריך; #scr("back") ו-#keycap("Esc") חוזרים לתרגולי השלב.

- *הכרטיס*: שם התרגול, השלב והמספר, ושתי פסקאות קצרות: #scr("brief_mission"), מי טס, מה, איפה ומתי; #scr("brief_target"), מה תדעו לעשות בסיום התרגול ובאיזה תקן.
- *כרטיס הטקסט*: שאר הפקודה, בסדר הזה: #scr("brief_enemy"), #scr("brief_our_forces"), #scr("brief_weather_area"); #scr("brief_execution"), השלבים ממוספרים כמו הסיכות שבמפה, ומעל כל שלב של תמרון השרטוט שלו, מלמעלה ומהצד, עם נקודות המפתח ממוספרות ומה להחזיק בכל אחת; #scr("brief_graded"), כל סעיף והתקן שלו; #scr("brief_coordination") ו#scr("brief_signal").

אותם שלבים, שרטוטים ותקנים נמצאים בטיסה בלשונית #scr("nb_lesson") של ה#term("פנקס") (@notebook-tabs).

=== המפה <briefing-map>

#idx("מפת התדריך")במפה הצפון למעלה. היא נפתחת על הבסיס: עמדת החניה, נתיב ההסעה והמסלול.

היא מציגה:

- את הקרקע כצילום אוויר, עם הכבישים הראשיים ושמות היישובים;
- את הבסיס: המסלולים עם המספרים שלהם, מסלולי ההסעה, הרחבות ועמדות החניה;
- את נתיב ההסעה מעמדת החניה אל המסלול, כקו מקווקו;
- את נתיב הטיסה מהמסלול דרך נקודות המשימה, עם חץ, ואת כיוון המסלול ליד הקטע הראשון שלו;
- את הנתיבים של המבנים האחרים, כל אחד בצבע משלו, במשימה שיש בה כאלה;
- חץ צפון וקנה מידה.

#idx("סיכות (מפת התדריך)")*הסיכות.* עיגול ממוספר עומד במקום שבו מתבצע חלק של #scr("how"). המספר הוא הפסקה הראשונה שמבצעים במקום הזה. תווית לידו נותנת את שם המקום:

#grid-table(
  (auto, 1fr),
  ([סיכה], [המקום]),
  [#scr("pin_start")], [עמדת החניה. כאן מתניעים את המטוס ומבצעים את הקריאות הראשונות.],
  [עצירה לפני המסלול], [#term("נקודת המתנה", shown: "נקודת ההמתנה"): המקום שבו עוצרים ומבקשים מהמגדל להתיישר על המסלול (@tower).],
  [המראה והכיוון], [המקום שבו מתיישרים על המסלול ומתחילים את ריצת ההמראה.],
)

*הזזת המפה.*

#grid-table(
  (auto, 1fr),
  ([כדי], [יש]),
  [להתקרב ולהתרחק], [לסובב את גלגלת העכבר, לצבוט במשטח מגע, או ללחוץ על + ועל − ליד #scr("map_zoom"). כשהמיקוד על המפה, ללחוץ על #keycap("+") או #keycap("-").],
  [לגלול], [לגרור בלחצן העכבר השמאלי או האמצעי, או לגלול בשתי אצבעות במשטח מגע. כשהמיקוד על המפה, להשתמש במקשי החצים.],
  [להציג שוב את אזור המשימה], [ללחוץ לחיצה כפולה על המפה, או ללחוץ על #keycap("0") כשהמיקוד עליה.],
)

אפשר להתרחק עד שרואים את כל הארץ, ולגלול לכל מקום בה.

*הלחצנים* שבראש המפה:

- #idx("תוויות (מפת התדריך)")#scr("map_labels") מציג או מסתיר את השמות: היישובים, מספרי המסלולים, הבסיס ותוויות הסיכות.
- #idx("צילום אוויר (מפת התדריך)")#scr("map_photo") מציג את הקרקע כצילום אוויר, או כמפה צבעונית פשוטה כשהוא כבוי.
- #scr("map_zoom") מקרב ומרחיק צעד אחד.
- #idx("מטרות PRE (מפת התדריך)")#scr("pre_title") מופיע רק כשהמטוס נושא פצצה מונחית GPS. הוא פותח את חלון מטרות PRE (@briefing-pre).

=== מטרות PRE <briefing-pre>

פצצה מונחית GPS (GBU-31, GBU-38, GBU-39, SPICE) במצב PRE טסה אל מטרה שתוכננה לפני הטיסה. כאן מתכננים אותה. יש לבחור #scr("pre_title") בראש המפה. החלון מופיע במקום הטקסט של המשימה ומונה את #term("תחנה", shown: "תחנות") ה-GPS של המטוס, כל אחת עם הפצצה שלה והמטרה שלה. מתלה של כמה פצצות (ארבע GBU-39 באדיר, שתי GBU-38 ב-F-16) נפתח לשורה לכל פצצה, הראשונה שמשתחררת למעלה.

+ ללחוץ על השורה של תחנה או של פצצה. #then[בשורה כתוב #scr("pre_click_map").]
+ ללחוץ על המטרה במפה: אחת ממטרות המשימה (ריבוע כתום עם שמה), אחת מנקודות הציון של המסלול, או כל מקום אחר במפה. #then[השורה מציגה את המטרה; במפה מסומנות ליד המטרה התחנות והפצצות שמכוונות אליה.]

לחיצה ימנית על שורה, או #keycap("Delete") כשהמיקוד עליה, מנקה את המטרה שלה. תחנה בלי מטרה משלה מקבלת את נקודת הציון של מטרת המשימה (בשורה שלה כתוב "· ברירת מחדל" אחרי המטרה). פצצה בלי מטרה משלה מקבלת את המטרה של התחנה שלה.

המטרות נשמרות עם תצורת החימוש של המטוס, ותצורת חימוש ששומרים במסך החימוש שומרת אותן (@loadout). מטרה או נקודת ציון נשמרות לפי המספר שלהן, ולכן תצורת חימוש שמורה מכוונת לאותם מספרים גם במשימה אחרת; מקום במפה שייך למשימה שבה נבחר. שורה שמחליפים את החימוש בתחנה שלה במסך החימוש מאבדת את המטרה שלה.

בטיסה כל פצצה מקבלת את המטרה שלה. #key("GPS bomb next PRE target") מעביר את הפצצה הבאה מהמטרה שלה אל שאר המטרות המתוכננות ואל נקודות הציון.

=== המשך אל הטיסה <briefing-go>

+ לקרוא את #scr("learn") ואת #scr("how").
+ למצוא כל סיכה במפה.
+ כדי לשנות את החימוש, לבחור #scr("tab_arming") או #scr("edit").
  #then[מסך החימוש נפתח (@loadout).]
+ לבחור #scr("fly").
  #then[מסך הטעינה מוצג (@loading), ואז הטיסה מתחילה.]

#note[#scr("fly") כבוי כל עוד אי אפשר לטוס בתצורת החימוש: משקל ההמראה מעל המרבי, או שחימוש זקוק לפוד שאינו על המטוס. החלק #scr("tab_arming") בכרטיס מציג את הסיבה. אחרי שינוי התצורה (@loadout-rules), #scr("fly") פעיל שוב.]

#scr("back") או #keycap("Esc") חוזרים לרשימת המשימות. #keycap("Tab") מעביר את המיקוד בין הלחצנים, לחצני המפה, המפה והטקסט.
