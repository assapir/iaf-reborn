#import "/modern-iaf/manuals/layout/manual.typ": *

#idx("דת״ק")#idx("התפריט הראשי")ה#term("דת״ק") הוא המסך הראשון של המשחק והתפריט הראשי שלו. כל הפעלה פותחת אותו עם המטוס שנבחר לאחרונה. ממנו מגיעים לכל מסך אחר.

#screen("hangar", [הדת״ק: המטוסים, המטוס שנבחר והכרטיס שלו.])

=== מה יש בדת״ק <main-menu-entries>

#grid-table(
  (auto, auto, 1fr),
  ([פריט], [היכן], [מה הוא עושה]),
  [#scr("hangar")], [הסרגל העליון], [החוליה הראשונה בנתיב הניווט שבכל מסך. פותח את הדת״ק.],
  [#scr("preferences")], [הסרגל העליון], [פותח את ההגדרות: גרפיקה, שפה, שמע והתקנים (@settings).],
  [הפרופיל], [הסרגל העליון], [הכינוי, השם והתמונה, כלחצן אחד. פותח את המסך #scr("pilot"), וממנו את #scr("pilot_log") (@pilots).],
  [#scr("aircraft")], [הרשימה שבצד], [המטוסים. בחירה באחד מהם קובעת אותו לכל המסכים הבאים (@hangar). מטוסים שהמשחק עדיין אינו מטיס מעומעמים.],
  [המטוס], [המרכז], [המטוס שנבחר, עם החימוש של #term("תצורת חימוש", shown: "תצורת החימוש") שלו. אפשר להביט בו מכל צד (@main-menu-jet).],
  [הכרטיס], [הלוח שבצד], [#scr("squadron_l"), #scr("base_l") ו#scr("tail_number") של המטוס שנבחר; אחריהם #scr("training"): כמה משיעורי המטוס עברו, והטיסה האחרונה במטוס עם התוצאה שלה.],
  [#scr("fly")], [הכרטיס], [פותח את המסך #scr("missions") למטוס שנבחר: אימונים ושאר החלקים (@mission-list). הלחצן נבחר מראש כשהדת״ק נפתח, ולכן לחיצה על #keycap("Enter") ממשיכה ישר הלאה.],
  [#scr("credits")], [התחתית], [פותח את רשימת המקורות של המשחק והרישיונות שלהם. מקשי החצים גוללים אותה. אותה רשימה נמצאת ב@attributions.],
  [#scr("manuals")], [התחתית], [פותח את רשימת ארבעת המדריכים (@manuals-screen).],
  [#scr("quit")], [התחתית], [שואל #scr("quit_q"), ואז סוגר את המשחק (@start-game-quit).],
)

כשנתוני המשחק לא נבנו, הכרטיס מודיע על כך במקום התקדמות האימון ומציין את פקודת ההתקנה, והלחצן #scr("fly") מעומעם (@after-update-no-missions).

=== מבט על המטוס <main-menu-jet>

#idx("דת״ק, המבט על המטוס")
#grid-table(
  (auto, 1fr),
  ([קלט], [מה הוא עושה]),
  [גרירה בעכבר], [גרירה לצדדים מסובבת את המטוס סיבוב מלא. גרירה למעלה ולמטה מנמיכה ומגביהה את נקודת המבט.],
  [גלגלת העכבר, או גלילה או צביטה בשתי אצבעות], [מקרבת ומרחיקה.],
  [לחיצה כפולה], [חוזרת למבט ההתחלתי.],
  [הסטיק הימני וההדקים של בקר משחק], [הסטיק מסובב את המבט; ההדק הימני מקרב, והשמאלי מרחיק. לחיצה על הסטיק חוזרת למבט ההתחלתי.],
  [כשהמיקוד על המטוס אחרי #keycap("Tab"): מקשי החצים, #keycap("+") ו#keycap("−"), #keycap("0") או #keycap("Home")], [מסובבים את המבט, מקרבים ומרחיקים, וחוזרים למבט ההתחלתי.],
)

המבט נשאר כפי שהיה כשבוחרים מטוס אחר.

=== מעבר בין מסכים <main-menu-moving>

#idx("חזרה")#idx("נתיב הניווט")
- *העכבר.* ללחוץ על לחצן או על שורה.
- *המקלדת.* מקשי החצים ו#keycap("Tab") מזיזים את המיקוד. #keycap("Enter") בוחר את הפקד שבמיקוד.
- *חזרה.* #keycap("Esc") חוזר מסך אחד אחורה. בסרגל התחתון של כל מסך יש לחצן #scr("back") שעושה אותו דבר. בדת״ק, #keycap("Esc") שואל #scr("quit_q"), ו#scr("cancel") נבחר מראש.
- *נתיב הניווט.* הסרגל העליון מציג את הדרך אל המסך הנוכחי: #scr("hangar"), המטוס, החלק, המשימה. בחירה באחד מהם פותחת את המסך שלו. הבחירות נשמרות.

אחרי טיסה המשחק חוזר בעצמו אל התפריטים ומציג את ה#term("תחקיר") של הטיסה (@debrief).
