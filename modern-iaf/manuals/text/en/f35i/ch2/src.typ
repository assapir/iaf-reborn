// Chapter 2's source for the F-35's flying rules, shared by its sections.
#import "/modern-iaf/manuals/layout/manual.typ": *
#let jet = book.jet
/// The United States Air Force's instruction on flying the F-35A, by paragraph.
#let afi-full(place) = footnote[United States Air Force Instruction 11-2F-35A, Volume 3, "F-35A Operations Procedures", 7 June 2012, #place. Its cover states that it has no releasability restrictions. It was written while the jet was still in development, and it holds flying rules, not a checklist: the F-35's flight manual and checklist are not public.]
#let afi(place) = footnote[United States Air Force Instruction 11-2F-35A, Volume 3 (its full reference is in @preflight), #place.]
