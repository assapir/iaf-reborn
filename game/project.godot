; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="iaf-reborn"
config/description="Native re-implementation of Jane's IAF (1998)"
run/main_scene="res://menu/front_end.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/image="res://../assets/converted/menu/img/back0.png"
boot_splash/bg_color=Color(0, 0, 0, 1)

[autoload]

Settings="*res://settings.gd"
Joystick="*res://controls/joystick.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
display_server/driver.linuxbsd="wayland"

[shader_globals]

terrain_detail={
"type": "float",
"value": 0.0
}
terrain_detail_tex={
"type": "sampler2D",
"value": "res://terrain/detail_noise.tres"
}
terrain_detail_normal={
"type": "sampler2D",
"value": "res://terrain/detail_normal.tres"
}

[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

anti_aliasing/quality/msaa_3d=2
