#!/usr/bin/env bash
# Builds what changed (the Rust extension, the same one ./iafjets loads) and starts IAF 2026 (iaf-2026/docs/README.md).
# Without the sim's data it starts its setup (./iaf2026-setup). Extra arguments go to the sim (after --).
# Until its front end (item E2) the sim has no screen: this runs the M0 probe (iaf-2026/tests/test_m0_boot.gd), or with
# `-- --mission <id>` one mission (iaf-2026/flight/fly.gd).
set -euo pipefail
cd "$(dirname "$0")"
[[ -d assets/converted/own ]] || { echo "No IAF 2026 data yet: starting its setup (./iaf2026-setup)." >&2; exec ./iaf2026-setup; }
cargo build --release -p iaf-godot
godot=${GODOT:-godot}
if ! command -v "$godot" >/dev/null && [[ -x /Applications/Godot.app/Contents/MacOS/Godot ]]; then
	godot=/Applications/Godot.app/Contents/MacOS/Godot
fi
tools/godot_import.sh "$godot" iaf-2026
[[ $(uname) == Darwin ]] && export SDL_JOYSTICK_MFI=${SDL_JOYSTICK_MFI:-0}
if [[ ! -f iaf-2026/main.tscn && " $* " == *" --mission "* ]]; then
	# One mission without the front end (iaf-2026/flight/fly.gd), until item E2.
	exec "$godot" --path iaf-2026 res://flight/fly.tscn -- "$@"
fi
if [[ ! -f iaf-2026/main.tscn ]]; then
	echo "IAF 2026's front end comes with item E2; the M0 probe meanwhile:"
	log=$(mktemp "${TMPDIR:-/tmp}/iaf2026-m0.XXXXXX")
	IAF_DEFAULT_SETTINGS=1 exec "$godot" --headless --audio-driver Dummy --path iaf-2026 -s ../iaf-2026/tests/test_m0_boot.gd --log-file "$log"
fi
exec "$godot" --path iaf-2026 res://main.tscn -- "$@"
