#!/usr/bin/env bash
# Modern IAF's setup wizard (modern-iaf/docs/setup.md): checks for Rust (cargo) and Godot, builds the extension, then opens
# the wizard's window (tools/launch-wizard.sh), which builds the sim's data into assets/. Run it again at any time:
# the finished steps are kept. The scripted way (modern-iaf/docs/setup.md §3): `iaf-sim terrain`, then `iaf-sim all`.
exec "$(dirname "$0")/tools/launch-wizard.sh" modern-iaf "Modern IAF — Setup" 1100x720
