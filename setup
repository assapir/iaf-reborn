#!/usr/bin/env bash
# The setup wizard (docs/setup.md): checks for Rust (cargo) and Godot, builds the game's extension, then opens the
# wizard's window (tools/launch-wizard.sh). Run it again at any time to add an extra or redo a step.
# tools/setup-cli.sh is the scripted way.
exec "$(dirname "$0")/tools/launch-wizard.sh" iaf-reborn "Jane's IAF (reborn) — Setup" 1200x820
